---
// src/pages/projects/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";

const allProjects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);

const featured = allProjects.filter((p) => p.data.featured);
const done     = allProjects.filter((p) => p.data.status === "done" && !p.data.featured);
const wip      = allProjects.filter((p) => p.data.status === "wip" && !p.data.featured);
const archived = allProjects.filter((p) => p.data.status === "archived");
const stacks   = [...new Set(allProjects.flatMap((p) => p.data.stack))].sort();
---

<Layout title="projects" description="Things I've built — open source projects and experiments.">

  <header class="py-10 text-center" data-animate>
    <h1 class="text-4xl font-bold tracking-tight text-base-heading md:text-5xl">
      <span class="text-gradient">Projects</span>
    </h1>
    <p class="mt-3 text-lg text-base-subtle">
      {allProjects.length} {allProjects.length === 1 ? "project" : "projects"} across {stacks.length} technologies
    </p>
  </header>

  {featured.length > 0 && (
    <section class="mt-14" data-animate>
      <h2 class="section-title text-left font-code text-[1.15rem] font-semibold text-teal">[ featured ]</h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  {wip.length > 0 && (
    <section class="mt-20" data-animate>
      <h2 class="section-title text-left font-code text-[1.15rem] font-semibold text-teal">[ wip ]</h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {wip.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  {done.length > 0 && (
    <section class="mt-20" data-animate>
      <h2 class="section-title text-left font-code text-[1.15rem] font-semibold text-teal">[ done ]</h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {done.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  {archived.length > 0 && (
    <section class="mt-20" data-animate>
      <h2 class="section-title text-left font-code text-[1.15rem] font-semibold text-teal">[ archived ]</h2>
      <div class="grid gap-8 opacity-60 md:grid-cols-2 lg:grid-cols-3">
        {archived.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

</Layout>