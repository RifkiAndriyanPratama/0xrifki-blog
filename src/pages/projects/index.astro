---
// src/pages/projects/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";

const allProjects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);

const featured = allProjects.filter((p) => p.data.featured);
const done     = allProjects.filter((p) => p.data.status === "done" && !p.data.featured);
const wip      = allProjects.filter((p) => p.data.status === "wip" && !p.data.featured);
const archived = allProjects.filter((p) => p.data.status === "archived");
const stacks   = [...new Set(allProjects.flatMap((p) => p.data.stack))].sort();
---

<Layout title="projects" description="Things I've built — open source projects and experiments." data-animate>

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <header class="mb-12" data-animate>
    <p class="font-code mb-2 text-sm text-base-subtle">
      <a href="/" class="underline underline-offset-2 transition-colors hover:text-base-text">~/</a>
      <span class="text-base-muted">projects</span>
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-base-text md:text-4xl">/projects</h1>
    <p class="mt-2 text-base-subtle">
      {allProjects.length} {allProjects.length === 1 ? "project" : "projects"} across {stacks.length} technologies
    </p>
  </header>

  <!-- ── Featured ──────────────────────────────────────────────────────────── -->
  {featured.length > 0 && (
    <section class="mb-14" data-animate>
      <h2 class="font-code mb-5 text-xs font-medium uppercase tracking-widest text-base-yellow">
        ★ featured
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <!-- ── In Progress ───────────────────────────────────────────────────────── -->
  {wip.length > 0 && (
    <section class="mb-12" data-animate>
      <h2 class="font-code mb-5 text-xs font-medium uppercase tracking-widest text-base-subtle">
        in progress
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {wip.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <!-- ── Shipped ───────────────────────────────────────────────────────────── -->
  {done.length > 0 && (
    <section class="mb-12" data-animate>
      <h2 class="font-code mb-5 text-xs font-medium uppercase tracking-widest text-base-subtle">
        shipped
      </h2>
      <div class="grid gap-5 sm:grid-cols-2">
        {done.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <!-- ── Archived ──────────────────────────────────────────────────────────── -->
  {archived.length > 0 && (
    <section data-animate>
      <h2 class="font-code mb-5 text-xs font-medium uppercase tracking-widest text-base-subtle">
        archived
      </h2>
      <div class="grid gap-5 sm:grid-cols-2 opacity-60">
        {archived.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

</Layout>
