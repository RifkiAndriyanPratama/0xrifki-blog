---
// src/pages/projects/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectCard from "@/components/ProjectCard.astro";

const allProjects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);

const featured = allProjects.filter((p) => p.data.featured);
const done     = allProjects.filter((p) => p.data.status === "done" && !p.data.featured);
const wip      = allProjects.filter((p) => p.data.status === "wip" && !p.data.featured);
const archived = allProjects.filter((p) => p.data.status === "archived");
const stacks   = [...new Set(allProjects.flatMap((p) => p.data.stack))].sort();
---

<Layout title="projects" description="Things I've built — open source projects and experiments.">

  <!-- ── Header ────────────────────────────────────────────────────────────── -->
  <header class="mb-16" data-animate>
    <h1 class="text-3xl font-semibold tracking-tight text-base-text md:text-4xl">Projects</h1>
    <p class="mt-2 text-base-subtle">
      {allProjects.length} {allProjects.length === 1 ? "project" : "projects"} across {stacks.length} technologies
    </p>
  </header>

  <!-- ── Featured ──────────────────────────────────────────────────────────── -->
  {featured.length > 0 && (
    <section class="mb-20" data-animate>
      <h2 class="mb-5 text-sm font-medium uppercase tracking-wider text-base-yellow">
        ★ Featured
      </h2>
      <div class="grid gap-8 sm:grid-cols-2">
        {featured.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <!-- ── In Progress ───────────────────────────────────────────────────────── -->
  {wip.length > 0 && (
    <section class="mb-16" data-animate>
      <h2 class="mb-5 text-sm font-medium uppercase tracking-wider text-base-subtle">
        In progress
      </h2>
      <div class="grid gap-8 sm:grid-cols-2">
        {wip.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <!-- ── Shipped ───────────────────────────────────────────────────────────── -->
  {done.length > 0 && (
    <section class="mb-16" data-animate>
      <h2 class="mb-5 text-sm font-medium uppercase tracking-wider text-base-subtle">
        Shipped
      </h2>
      <div class="grid gap-8 sm:grid-cols-2">
        {done.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  <!-- ── Archived ──────────────────────────────────────────────────────────── -->
  {archived.length > 0 && (
    <section data-animate>
      <h2 class="mb-5 text-sm font-medium uppercase tracking-wider text-base-subtle">
        Archived
      </h2>
      <div class="grid gap-8 sm:grid-cols-2 opacity-60">
        {archived.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

</Layout>
