---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getCollection("projects");
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
};

const { project } = Astro.props;
const { name, description, stack, github, cover, coverAlt, status } = project.data;

const statusLabel = { wip: "in progress", done: "shipped", archived: "archived" } as const;
const statusColor = { wip: "text-base-yellow border-base-yellow/40", done: "text-base-green border-base-green/40", archived: "text-base-muted border-base-overlay" } as const;
---

<Layout title={name} description={description}>
  <article class="max-w-2xl">
    <div data-animate>
      <a
        href="/projects"
        class="font-code text-xs text-base-muted underline underline-offset-4 transition-colors hover:text-base-text"
      >
        ← back to projects
      </a>
    </div>

    <header class="mb-8 mt-6 space-y-4" data-animate>
      <div class="flex flex-wrap items-center gap-3">
        <span class={`font-code inline-block rounded border px-2 py-0.5 text-xs ${statusColor[status]}`}>
          {statusLabel[status]}
        </span>
      </div>

      <h1 class="text-2xl font-semibold leading-tight tracking-tight text-base-text md:text-3xl">
        {name}
      </h1>

      <p class="text-base text-base-subtle">{description}</p>

      <div class="flex flex-wrap gap-2">
        {stack.map((tech) => (
          <span class="font-code rounded bg-base-surface px-2 py-0.5 text-xs text-base-muted">
            {tech}
          </span>
        ))}
      </div>

      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 font-code text-sm text-base-blue transition-colors hover:text-base-teal"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          {github.replace("https://github.com/", "")}
        </a>
      )}
    </header>

    {
      cover && (
        <div class="mb-10 overflow-hidden rounded-lg border border-base-overlay" data-animate>
          <Image
            src={cover}
            alt={coverAlt ?? name}
            class="w-full object-cover"
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 768px, 100vw"
            loading="eager"
          />
        </div>
      )
    }

    <div class="prose prose-devlog max-w-none" data-animate>
      <slot />
    </div>
  </article>
</Layout>
