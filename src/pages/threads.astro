---
// src/pages/threads.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { sortPosts } from "@/lib/utils";
import ThreadCard from "@/components/ThreadCard.astro";

const threads = sortPosts(await getCollection("posts", ({ data }) => !data.draft && data.type === "foto"));
const entries = await Promise.all(
  threads.map(async (t) => {
    const { Content } = await t.render();
    return { t, Content };
  })
);
---

<Layout title="Frames" description="Feed ringan & singkat — foto post, capaian kecil, cuplikan kehidupan.">

  <div class="mx-auto max-w-2xl py-8 sm:py-12">
    <header class="mb-6 sm:mb-8" data-animate>
      <h1 class="font-serif text-3xl font-bold tracking-tight text-base-heading sm:text-4xl">Frames</h1>
      <p class="mt-2 text-sm leading-relaxed text-base-subtle sm:text-base">
        Frame Hari Ini — cuplikan kecil, capaian, dan foto. {entries.length} frame.
      </p>
    </header>

    <div class="flex flex-col gap-5">
      {entries.length === 0 && (
        <p class="rounded-2xl border border-dashed border-base-overlay p-8 text-center text-sm text-base-muted">
          Belum ada frame. Post foto dengan <code class="font-code">type: "foto"</code> untuk mulai.
        </p>
      )}
      {entries.map(({ t, Content }) => (
        <ThreadCard thread={t} full={true} body={Content} />
      ))}
    </div>
  </div>

</Layout>