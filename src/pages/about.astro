---
// src/pages/about.astro
import Layout from "@/layouts/Layout.astro";
import Avatar from "@/components/Avatar.astro";
import { siteConfig } from "@/config/site";

const socialIcons: Record<string, string> = {
  GitHub:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.11-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>',
  Instagram:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>',
  RSS: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>',
};
---

<Layout title="Tentang" description="Tentang thestoriesrifki dan penulisnya.">

  <div class="mx-auto max-w-2xl py-8 sm:py-12">
    <section class="flex flex-col items-center gap-4 text-center" data-animate>
      <Avatar size="lg" letter={siteConfig.avatarLetter} ring={true} />
      <div>
        <h1 class="font-serif text-3xl font-bold tracking-tight text-base-heading sm:text-4xl">{siteConfig.name}</h1>
        <p class="mt-1 font-code text-xs uppercase tracking-widest text-base-teal sm:text-sm">{siteConfig.role}</p>
        <p class="mt-0.5 text-sm text-base-muted">{siteConfig.username}</p>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-base-subtle sm:text-base">{siteConfig.bio}</p>
      <div class="flex items-center gap-1">
        {siteConfig.socials.map((s) => (
          <a
            key={s.label}
            href={s.href}
            target={s.href.startsWith("http") ? "_blank" : undefined}
            rel="noopener noreferrer"
            aria-label={s.label}
            class="flex h-10 w-10 items-center justify-center rounded-full border border-base-overlay text-base-text transition-colors hover:border-base-teal hover:text-base-heading"
            set:html={socialIcons[s.label]}
          />
        ))}
      </div>
    </section>

    <section class="mt-10 rounded-2xl border border-base-overlay p-6" data-animate>
      <h2 class="text-xs font-semibold uppercase tracking-widest text-base-muted">Tentang Situs Ini</h2>
      <p class="mt-3 text-sm leading-relaxed text-base-subtle sm:text-base">{siteConfig.about.text}</p>
<ul class="mt-4 flex flex-col gap-1.5 text-sm text-base-text">
      <li>• <a href="/blog" class="text-base-teal transition-colors hover:underline">Artikel</a> untuk pemikiran panjang.</li>
      <li>• <a href="/frames" class="text-base-teal transition-colors hover:underline">Frames</a> untuk cuplikan kecil & foto.</li>
      <li>• <a href="/rss.xml" class="text-base-teal transition-colors hover:underline">RSS</a> untuk langganan.</li>
      <li>• <a href="/colophon" class="text-base-teal transition-colors hover:underline">Colophon</a>: teknis & desain di balik situs ini.</li>
    </ul>
  </section>

  <p class="mt-10 text-center font-signature text-3xl text-base-heading">{siteConfig.name}</p>

  <p class="mt-6 text-center font-code text-xs text-base-muted">
    Dibangun dengan Astro · Tailwind · Deployed on Vercel
  </p>
  </div>

</Layout>