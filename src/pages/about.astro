---
// src/pages/about.astro
import Layout from "@/layouts/Layout.astro";
---

<Layout title="tentang" description="Rifki Andriyan Pratama — mahasiswa, penulis, dan tukang baca dokumentasi.">

  <div class="mx-auto max-w-3xl">

    <header class="pt-10 text-center" data-animate>
      <div
        class="mx-auto flex h-24 w-24 items-center justify-center rounded-full p-[4px]"
        style="background: linear-gradient(135deg, var(--color-teal), var(--color-blue))"
      >
        <span class="flex h-full w-full items-center justify-center rounded-full bg-base-surface font-code text-3xl font-bold text-gradient select-none">
          rp
        </span>
      </div>
      <h1 class="mt-6 text-4xl font-bold tracking-tight text-base-heading md:text-5xl">
        Rifki Andriyan Pratama
      </h1>
      <p class="mt-3 text-lg text-base-subtle">
        mahasiswa, penulis, dan tukang baca dokumentasi.
      </p>
    </header>

    <div class="mt-14 space-y-5 text-[17px] leading-relaxed text-base-subtle" data-animate style="animation-delay: 80ms">
      <p>
        halo! aku Rifki. mahasiswa informatika yang suka banget ngulik soal komputer, mulai dari hal paling dasar sampai yang kompleks.
        suka nulis biar apa yang dipelajari bisa dipahami orang lain juga.
      </p>
      <p>
        topik yang sering aku bahas: pemrograman, sistem operasi, DevOps, dan sesekali curhat soal kuliah.
        bahasanya sengaja dibuat santai dan gampang dipahami, karena menurut aku belajar harusnya nggak bikin pusing.
      </p>
      <p>
        blog ini tempat aku nulis apa aja yang lagi dipelajari. kadang tutorial, kadang catatan, kadang opini.
        semoga ada yang berguna buat kamu juga.
      </p>
      <p>
        kalau mau ngobrol, hubungi aku lewat media sosial di bawah.
      </p>
    </div>

    <section class="mt-16" data-animate style="animation-delay: 160ms">
      <h2 class="section-title text-left">Topik yang Sering Dibahas</h2>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {[
          { label: "Programming",   items: ["C++", "Python", "TypeScript", "Bash", "Rust"] },
          { label: "Sistem",        items: ["Linux", "Jaringan", "Docker", "Shell"] },
          { label: "Tools",         items: ["Neovim", "Git", "GitHub Actions", "Nginx"] },
        ].map(({ label, items }) => (
          <div class="js-card flex flex-col gap-2 p-6">
            <p class="font-code text-xs font-semibold uppercase tracking-widest text-base-muted">{label}</p>
            <div class="flex flex-wrap gap-1.5">
              {items.map((item) => (
                <span class="tag-chip text-xs" style="--tag-color: #5fedac">{item}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-16" data-animate style="animation-delay: 240ms">
      <h2 class="section-title text-left">Temukan Aku</h2>
      <div class="flex flex-col gap-3 text-[15px]">
        {[
          { label: "GitHub",    href: "https://github.com/RifkiAndriyanPratama",        display: "github.com/RifkiAndriyanPratama" },
          { label: "LinkedIn",  href: "https://linkedin.com/in/RifkiAndriyanPratama",   display: "linkedin.com/in/RifkiAndriyanPratama" },
          { label: "Instagram", href: "https://instagram.com/thestoriesrifkii",          display: "@thestoriesrifkii" },
        ].map(({ label, href, display }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center gap-3 text-base-subtle transition-colors hover:text-base-heading"
          >
            <span class="w-24 text-base-muted">{label}</span>
            <span class="text-base-subtle transition-colors group-hover:text-base-teal">→</span>
            <span>{display}</span>
          </a>
        ))}
      </div>
    </section>

  </div>
</Layout>
