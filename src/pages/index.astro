---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { sortPosts } from "@/lib/utils";

const posts     = sortPosts(await getCollection("posts"));
const projects  = await getCollection("projects");
const featured  = posts.filter((p) => p.data.featured);
const recent    = posts.slice(0, 5);

---

<Layout title="0xrifki">

  <section class="relative mb-40 overflow-hidden" data-animate style="animation-delay: 0ms">
    <!-- Background grid pattern -->
    <div class="hero-grid pointer-events-none absolute inset-0 opacity-15 dark:opacity-10"></div>

    <div class="relative z-10">
      <div class="mb-6 flex flex-col gap-6 sm:flex-row sm:items-center">
        <!-- Avatar -->
        <div class="relative h-20 w-20 shrink-0 overflow-hidden rounded-2xl border border-base-overlay sm:h-24 sm:w-24">
          <div class="flex h-full w-full items-center justify-center bg-base-surface">
            <span class="font-code text-3xl font-bold text-base-teal select-none">rp</span>
          </div>
        </div>

        <div>
          <h1 class="text-4xl font-semibold leading-tight tracking-tight text-base-text md:text-5xl">
            a developer's notebook.<br />
            <span class="text-gradient">projects, systems & tooling.</span>
          </h1>
        </div>
      </div>

      <p class="mb-8 max-w-xl text-base leading-relaxed text-base-subtle md:text-lg">
        cs student by day, terminal addict by night.<br />
        notes on software, systems, and whatever ends up in the terminal at 2am.
      </p>

      <!-- Stats row -->
      <div class="mb-10 flex flex-wrap gap-8">
        <div>
          <p class="stat-number" data-count={posts.length}>0</p>
          <p class="stat-label">posts</p>
        </div>
        <div>
          <p class="stat-number" data-count={projects.length}>0</p>
          <p class="stat-label">projects</p>
        </div>
      </div>

      <!-- CTA row -->
      <div class="flex flex-wrap gap-3">
        <a
          href="/blog"
          class="btn-primary"
        >
          read blog →
        </a>
        <a
          href="/projects"
          class="rounded-lg border border-base-overlay px-5 py-2.5 text-sm text-base-subtle transition-all hover:border-base-subtle hover:text-base-text"
        >
          view projects →
        </a>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="mb-20" data-animate style="animation-delay: 80ms">
      <h2 class="mb-6 text-sm font-medium text-base-yellow">
        ★ Featured
      </h2>
      <div>
        {featured.map((post, i) => (
          <div data-animate style={`animation-delay: ${100 + i * 60}ms`}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="mb-16" data-animate style="animation-delay: 120ms">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-sm font-medium text-base-subtle">
        Recent posts
      </h2>
      <a
        href="/blog"
        class="text-sm text-base-muted underline underline-offset-4 transition-colors hover:text-base-text"
      >
        all posts →
      </a>
    </div>

    <div class="space-y-6">
      {recent.map((post, i) => (
        <div data-animate style={`animation-delay: ${180 + i * 60}ms`}>
          <PostCard post={post} />
        </div>
      ))}
    </div>
  </section>

</Layout>

<script>
function initStats() {
  const stats = document.querySelectorAll("[data-count]");
  if (!stats.length) return;
  const obs = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = parseInt(el.dataset.count);
      const duration = 1200;
      const start = performance.now();
      function update(now) {
        const elapsed = now - start;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.round(eased * target).toLocaleString();
        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
      obs.unobserve(el);
    });
  }, { threshold: 0.5 });
  stats.forEach((s) => obs.observe(s));
}

document.addEventListener("DOMContentLoaded", initStats);
document.addEventListener("astro:page-load", initStats);
</script>
