---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { sortPosts, isFoto } from "@/lib/utils";
import FrameCard from "@/components/FrameCard.astro";
import PostRow from "@/components/PostRow.astro";
import SidebarLeft from "@/components/SidebarLeft.astro";
import SidebarRight from "@/components/SidebarRight.astro";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const articles = posts.filter((p) => !isFoto(p));
const frames = posts.filter((p) => isFoto(p));
const latestPosts = articles.slice(0, 5);
const latestFrames = frames.slice(0, 6);
const popularPosts = [...posts]
  .sort((a, b) => b.data.readingTime - a.data.readingTime)
  .slice(0, 5);
const popularThreads = [...frames].slice(0, 3);

// Group by category
const categoryCounts = posts.reduce((acc, post) => {
  const cat = post.data.category;
  acc[cat] = (acc[cat] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);
const categories = Object.entries(categoryCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

// tags
const tagCounts = posts.reduce((acc, post) => {
  (post.data.tags ?? []).forEach((tag) => { acc[tag] = (acc[tag] ?? 0) + 1; });
  return acc;
}, {} as Record<string, number>);
const tags = Object.entries(tagCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 14);
---

<Layout title="thestoriesrifki">

  <div class="grid grid-cols-1 gap-10 py-8 sm:py-10 lg:grid-cols-[240px_minmax(0,1fr)_300px] lg:gap-12 lg:py-12">

    <!-- Kolom kiri -->
    <div class="hidden lg:block">
      <div class="lg:sticky lg:top-20">
        <SidebarLeft categories={categories} postCount={articles.length} threadCount={frames.length} />
      </div>
    </div>

    <!-- Kolom tengah -->
    <div class="flex min-w-0 flex-col gap-12">

      <!-- Kategori populer sebagai pill -->
      {categories.length > 0 && (
        <section data-animate aria-label="Kategori populer">
          <div class="flex flex-wrap items-center gap-2">
            <span class="mr-1 text-xs font-semibold uppercase tracking-widest text-base-subtle">Topik:</span>
            {categories.slice(0, 4).map((cat) => (
              <a
                key={cat.name}
                href={`/blog/category/${cat.name}`}
                class="tag-chip text-xs capitalize"
                style="--tag-color:var(--color-teal)"
              >
                {cat.name}
                <span class="ml-1 text-[10px] text-base-muted">{cat.count}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Latest posts -->
      <section data-animate>
        <div class="mb-4 flex items-center justify-between">
          <h2 class="font-serif text-xl text-base-heading">Latest Posts</h2>
          <a href="/blog" class="text-sm font-medium text-base-teal transition-colors hover:underline">Lihat semua →</a>
        </div>
        <div class="flex flex-col gap-4">
          {latestPosts.map((post) => <PostRow post={post} />)}
        </div>
      </section>

      <!-- Latest Frames -->
      {latestFrames.length > 0 && (
        <section data-animate>
          <div class="mb-4 flex items-center justify-between">
            <h2 class="font-serif text-xl text-base-heading">📸 Latest Frames</h2>
            <a href="/frames" class="text-sm font-medium text-base-teal transition-colors hover:underline">Lihat semua →</a>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
            {latestFrames.map((thread) => <FrameCard thread={thread} />)}
          </div>
        </section>
      )}

      <!-- Jelajahi (mobile saja): kategori & tag dalam accordion -->
      <section class="lg:hidden" data-animate>
        <details class="rounded-2xl border border-base-overlay bg-base-surface p-4" open={false}>
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-base-heading">
            Jelajahi
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-transform duration-200 [details[open]_&]:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {categories.map((cat) => (
              <a href={`/blog/category/${cat.name}`} class="tag-chip text-xs capitalize" style="--tag-color:var(--color-teal)">
                {cat.name}
                <span class="ml-1 text-[10px] text-base-muted">{cat.count}</span>
              </a>
            ))}
          </div>
          {tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <a href={`/search?q=${encodeURIComponent(t.name)}`} class="tag-chip text-xs" style="--tag-color:var(--color-blue)">
                  #{t.name}
                </a>
              ))}
            </div>
          )}
        </details>
      </section>

    </div>

    <!-- Kolom kanan (tablet: full-width 2-kolom di bawah konten) -->
    <div class="hidden min-w-0 md:block lg:sticky lg:top-20">
      <SidebarRight popularPosts={popularPosts} popularThreads={popularThreads} tags={tags} />
    </div>

  </div>

</Layout>