---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import { sortPosts, readingTime, formatDate, isoDate } from "@/lib/utils";

const posts = sortPosts(await getCollection("posts"));
const [featured, ...rest] = posts;
const latestPosts = posts.slice(0, 5);

// Group by category
const categories = posts.reduce((acc, post) => {
  const cat = post.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(post);
  return acc;
}, {} as Record<string, typeof posts>);
---

<Layout title="thestoriesrifki">

  <!-- 1. Hero -->
  <section class="pt-10 pb-8 sm:pt-16 sm:pb-10 lg:pt-20 lg:pb-12" data-animate>
    <div class="lg:flex lg:items-end lg:justify-between lg:gap-8">
      <div class="lg:flex-1">
        <h1 class="font-serif text-4xl font-bold tracking-tight text-base-heading sm:text-5xl lg:text-[3.5rem] lg:leading-[1.1]">
          thestoriesrifki
        </h1>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-base-subtle lg:text-xl">
          cerita seputar coding, teknologi, dan hidup.
        </p>
      </div>

      <button
        id="search-btn"
        class="mt-6 flex w-full max-w-md items-center gap-3 rounded-xl border border-base-overlay bg-base-bg-alt px-4 py-3 text-left text-sm text-base-muted transition-colors hover:border-base-teal lg:mt-0 lg:max-w-[280px]"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247Z"/></svg>
        <span>cari tulisan...</span>
        <kbd class="ml-auto hidden rounded border border-base-overlay px-1.5 py-0.5 text-xs text-base-muted sm:inline">⌘K</kbd>
      </button>
    </div>
  </section>

  <hr class="border-base-overlay" />

  <!-- 2. Postingan terbaru — 1 large card -->
  {featured && (
    <section class="py-10" data-animate>
      <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-base-muted">Postingan terbaru</h2>
      <a href={`/blog/${featured.slug}/`} class="group grid grid-cols-1 gap-6 sm:grid-cols-[1fr_280px] items-center rounded-2xl border border-base-overlay p-6 transition-all hover:border-base-teal hover:shadow-sm">
        <div>
          <div class="mb-3 flex items-center gap-2 text-sm text-base-muted">
            <time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{featured.data.readingTime ?? readingTime(featured.body)} min read</span>
          </div>
          <h3 class="font-serif text-2xl font-bold leading-snug tracking-tight text-base-heading transition-colors group-hover:text-base-teal lg:text-3xl">
            {featured.data.title}
          </h3>
          <p class="mt-3 text-base text-base-subtle leading-relaxed line-clamp-3">
            {featured.data.description}
          </p>
        </div>
        {featured.data.cover && (
          <div class="overflow-hidden rounded-xl">
            <Image
              src={featured.data.cover}
              alt={featured.data.coverAlt ?? featured.data.title}
              class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] sm:h-[200px]"
              widths={[400, 600]}
              sizes="(min-width: 640px) 280px, 100vw"
              loading="lazy"
            />
          </div>
        )}
      </a>
    </section>
  )}

  <hr class="border-base-overlay" />

  <!-- 3 & 4. Latest posts list + Categories -->
  <section class="py-10 lg:grid lg:grid-cols-[1fr_280px] lg:gap-12" data-animate>

    <!-- Left: latest posts -->
    <div>
      <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-base-muted">Semua tulisan</h2>
      <div class="flex flex-col divide-y divide-base-overlay">
        {latestPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="group flex items-start gap-4 py-4">
            <div class="min-w-0 flex-1">
              <h3 class="text-base font-semibold text-base-heading leading-snug transition-colors group-hover:text-base-teal">
                {post.data.title}
              </h3>
              <p class="mt-1 text-sm text-base-subtle line-clamp-1">{post.data.description}</p>
              <div class="mt-1.5 flex items-center gap-2 text-xs text-base-muted">
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{post.data.readingTime ?? readingTime(post.body)} min</span>
              </div>
            </div>
            {post.data.cover && (
              <Image
                src={post.data.cover}
                alt={post.data.coverAlt ?? post.data.title}
                class="h-16 w-16 shrink-0 rounded-lg object-cover sm:h-20 sm:w-20"
                width={80}
                height={80}
                loading="lazy"
              />
            )}
          </a>
        ))}
      </div>
      <a href="/" class="mt-6 inline-block text-sm font-medium text-base-teal transition-colors hover:underline">
        Lihat semua tulisan →
      </a>
    </div>

    <!-- Right: categories -->
    <div class="mt-10 lg:mt-0">
      <h2 class="mb-5 text-sm font-semibold uppercase tracking-wider text-base-muted">Kategori</h2>
      <div class="flex flex-col gap-2">
        {Object.entries(categories).map(([cat, catPosts]) => (
          <a
            href={`/blog/category/${cat}`}
            class="group flex items-center justify-between rounded-xl px-4 py-3 transition-colors hover:bg-base-bg-alt"
          >
            <span class="text-sm font-medium text-base-heading capitalize transition-colors group-hover:text-base-teal">{cat}</span>
            <span class="text-xs text-base-muted">{catPosts.length} tulisan</span>
          </a>
        ))}
      </div>
    </div>

  </section>

</Layout>
