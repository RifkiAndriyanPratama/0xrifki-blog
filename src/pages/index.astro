---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { sortPosts } from "@/lib/utils";

const posts = sortPosts(await getCollection("posts"));
---

<Layout title="thestoriesrifki">

  <!-- Hero -->
  <section class="pt-16 pb-8 sm:pt-24 sm:pb-12" data-animate>
    <h1 class="text-4xl font-bold tracking-tight text-base-heading sm:text-5xl">
      thestoriesrifki
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-base-subtle">
      cerita seputar coding, teknologi, dan hidup. ditulis dengan bahasa yang gampang dipahami.
    </p>
  </section>

  <!-- Divider -->
  <hr class="border-base-overlay" />

  <!-- Posts feed -->
  <section class="divide-y divide-base-overlay">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </section>

  {posts.length === 0 && (
    <div class="py-20 text-center">
      <p class="text-base-muted">belum ada tulisan.</p>
    </div>
  )}

</Layout>
