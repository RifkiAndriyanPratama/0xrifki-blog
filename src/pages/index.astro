---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { sortPosts, readingTime, formatDate, isoDate, isFoto } from "@/lib/utils";
import PostCover from "@/components/PostCover.astro";
import PhotoCard from "@/components/PhotoCard.astro";
import ThreadCard from "@/components/ThreadCard.astro";
import PostRow from "@/components/PostRow.astro";
import SidebarLeft from "@/components/SidebarLeft.astro";
import SidebarRight from "@/components/SidebarRight.astro";
import { tintBg, isLightTint } from "@/lib/tint";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const featuredPost = posts[0];
const latestPosts = posts.filter((p) => p !== featuredPost).slice(0, 6);
const threads = posts.filter((p) => isFoto(p));
const popularPosts = [...posts]
  .sort((a, b) => b.data.readingTime - a.data.readingTime)
  .slice(0, 5);
const popularThreads = [...threads].slice(0, 3);

// Dominant colours per post, generated at build time (scripts/generate-og.mjs)
function loadPostColors(): Record<string, { from: number[]; to: number[] }> {
  try {
    return JSON.parse(readFileSync(new URL("../../public/post-colors.json", import.meta.url), "utf8"));
  } catch {
    return {};
  }
}
const postColors = loadPostColors();
const featuredTint = featuredPost ? postColors[featuredPost.slug] : undefined;
const featuredLight = featuredTint ? isLightTint(featuredTint) : false;
const fMeta = featuredTint ? (featuredLight ? "text-black/70" : "text-white/75") : "text-base-muted";
const fChip = featuredTint ? (featuredLight ? "border-black/25 text-black/80" : "border-white/40 text-white/90") : "border-base-overlay";
const fTitle = featuredTint ? (featuredLight ? "text-black" : "text-white") : "text-base-heading group-hover:text-base-teal";
const fDesc = featuredTint ? (featuredLight ? "text-black/80" : "text-white/85") : "text-base-subtle";

// Group by category
const categoryCounts = posts.reduce((acc, post) => {
  const cat = post.data.category;
  acc[cat] = (acc[cat] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);
const categories = Object.entries(categoryCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

// tags
const tagCounts = posts.reduce((acc, post) => {
  (post.data.tags ?? []).forEach((tag) => { acc[tag] = (acc[tag] ?? 0) + 1; });
  return acc;
}, {} as Record<string, number>);
const tags = Object.entries(tagCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 14);
---

<Layout title="thestoriesrifki">

  <div class="grid grid-cols-1 gap-10 py-8 sm:py-10 lg:grid-cols-[240px_minmax(0,1fr)_300px] lg:gap-12 lg:py-12">

    <!-- Kolom kiri -->
    <div class="hidden lg:block">
      <div class="lg:sticky lg:top-20">
        <SidebarLeft categories={categories} postCount={posts.filter((p) => !isFoto(p)).length} threadCount={threads.length} />
      </div>
    </div>

    <!-- Kolom tengah -->
    <div class="flex min-w-0 flex-col gap-12">

      <!-- Featured -->
      {featuredPost && (
        <section data-animate>
          <h2 class="mb-4 text-sm font-semibold uppercase tracking-widest text-base-muted">Postingan terbaik</h2>
          {isFoto(featuredPost) ? (
            <PhotoCard post={featuredPost} tint={featuredTint} />
          ) : (
          <a href={`/blog/${featuredPost.slug}/`} class:list={[
              "group grid grid-cols-1 gap-5 rounded-2xl border p-4 transition-all sm:items-center sm:grid-cols-[1fr_280px] sm:gap-6 sm:p-6 card-lift",
              featuredTint
                ? (featuredLight ? "border-transparent" : "border-white/15")
                : "border-base-overlay",
            ]}
             style={featuredTint ? { background: tintBg(featuredTint) } : undefined}>
            <div>
              <div class:list={["mb-2 flex flex-wrap items-center gap-1.5 text-xs sm:mb-3 sm:gap-2 sm:text-sm", fMeta]}>
                <span class:list={["rounded-full border px-2 py-0.5 capitalize sm:px-2.5", fChip]}>{featuredPost.data.category}</span>
                <time datetime={isoDate(featuredPost.data.date)}>{formatDate(featuredPost.data.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{featuredPost.data.readingTime ?? readingTime(featuredPost.body)} min read</span>
              </div>
              <h3 class:list={["font-serif text-xl font-bold leading-snug tracking-tight transition-colors sm:text-2xl lg:text-3xl", fTitle]}>
                {featuredPost.data.title}
              </h3>
              <p class:list={["mt-2 text-sm leading-relaxed line-clamp-3 sm:mt-3 sm:text-base", fDesc]}>
                {featuredPost.data.description}
              </p>
            </div>
            {featuredPost.data.cover && (
              <div class="overflow-hidden rounded-xl">
                <PostCover
                  src={featuredPost.data.cover}
                  alt={featuredPost.data.coverAlt ?? featuredPost.data.title}
                  mode="featured"
                  class="h-40 w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] sm:h-[200px]"
                />
              </div>
            )}
          </a>
          )}
        </section>
      )}

      <!-- Kategori populer sebagai pill -->
      {categories.length > 0 && (
        <section data-animate aria-label="Kategori populer">
          <div class="flex flex-wrap items-center gap-2">
            <span class="mr-1 text-xs font-semibold uppercase tracking-widest text-base-muted">Topik:</span>
            {categories.slice(0, 4).map((cat) => (
              <a
                key={cat.name}
                href={`/blog/category/${cat.name}`}
                class="tag-chip text-xs capitalize"
                style="--tag-color:var(--color-teal)"
              >
                {cat.name}
                <span class="ml-1 text-[10px] text-base-muted">{cat.count}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Latest blog posts -->
      <section data-animate>
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-widest text-base-muted">Latest Blog Posts</h2>
          <a href="/blog" class="text-sm font-medium text-base-teal transition-colors hover:underline">Lihat semua →</a>
        </div>
        <div class="flex flex-col">
          {latestPosts.map((post) =>
            isFoto(post) ? (
              <div class="py-3 sm:py-3.5">
                <PhotoCard post={post} />
              </div>
            ) : (
              <PostRow post={post} />
            )
          )}
        </div>
      </section>

      <!-- Threads / Frame Hari Ini -->
      {threads.length > 0 && (
        <section data-animate>
          <div class="mb-4 flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-widest text-base-muted">Frame Hari Ini</h2>
            <a href="/threads" class="text-sm font-medium text-base-teal transition-colors hover:underline">Lihat semua →</a>
          </div>
          <div class="no-scrollbar -mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:px-0">
            {threads.map((thread) => <ThreadCard thread={thread} />)}
          </div>
        </section>
      )}

      <!-- Jelajahi (mobile saja): kategori & tag dalam accordion -->
      <section class="lg:hidden" data-animate>
        <details class="rounded-2xl border border-base-overlay bg-base-surface p-4" open={false}>
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-base-heading">
            Jelajahi
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-transform duration-200 [details[open]_&]:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {categories.map((cat) => (
              <a href={`/blog/category/${cat.name}`} class="tag-chip text-xs capitalize" style="--tag-color:var(--color-teal)">
                {cat.name}
                <span class="ml-1 text-[10px] text-base-muted">{cat.count}</span>
              </a>
            ))}
          </div>
          {tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <a href={`/search?q=${encodeURIComponent(t.name)}`} class="tag-chip text-xs" style="--tag-color:var(--color-blue)">
                  #{t.name}
                </a>
              ))}
            </div>
          )}
        </details>
      </section>

    </div>

    <!-- Kolom kanan -->
    <div class="hidden lg:block">
      <div class="lg:sticky lg:top-20">
        <SidebarRight popularPosts={popularPosts} popularThreads={popularThreads} tags={tags} />
      </div>
    </div>

  </div>

</Layout>