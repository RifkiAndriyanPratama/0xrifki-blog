---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { sortPosts } from "@/lib/utils";

const posts     = sortPosts(await getCollection("posts"));
const projects  = await getCollection("projects");
const recent    = posts.slice(0, 6);

const tagCounts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
}
const popularTags = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6);
---

<Layout title="0xrifki">

  <div class="relative">
    <div class="page-animated-bg" aria-hidden="true">
      <div class="hero-bg-dots"></div>
      <div class="aurora aurora-1"></div>
      <div class="aurora aurora-2"></div>
      <div class="aurora aurora-3"></div>
      <div class="aurora aurora-4"></div>
      <div class="aurora aurora-5"></div>
    </div>

  <!-- ============ HERO ============ -->
  <section class="relative flex min-h-screen items-center py-12 sm:py-24">
    <div class="grid w-full items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- Left -->
      <div>
        <h1 class="mt-6 font-code text-xl font-bold leading-[1.4] tracking-tight sm:text-3xl md:text-[2.5rem]" data-animate style="animation-delay: 90ms">
          <span class="block text-sm sm:text-lg">
            <span class="h-prompt">~/0xrifki:$</span> <span class="h-key">whoami</span>
          </span>
          <span class="mt-1 block text-base-heading">
            <span id="typewriter" class="gradient-animated" aria-hidden="true" data-phrases='["rifki — cs student · terminal addict","a builder of low-level things","learning the kernel at 2am"]'></span><span class="typing-cursor" aria-hidden="true"></span>
          </span>
        </h1>
        <span class="sr-only">rifki — cs student, terminal addict. Sharing what I learn from software, systems, and tooling.</span>

        <p class="mt-5 font-code text-base leading-relaxed text-base-muted sm:text-lg" data-animate style="animation-delay: 180ms">
          <span class="h-comment">// sharing what i learn from software, systems, and tooling.</span>
          <br />
          <span class="h-comment">// easy to understand, enjoyable to explore.</span>
        </p>
      </div>

      <!-- Right: animated cover + floating badges -->
      <div class="relative mx-auto w-full max-w-[440px]" data-animate style="animation-delay: 150ms">
        <div class="hero-glow-ring"></div>

        <div class="tilt-wrap relative" data-tilt>
          <div class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-base-overlay shadow-[0_24px_60px_-20px_rgba(0,0,0,0.4)] hero-float-slow">
            <img
              src="/hero-cover.svg"
              alt="Low-level systems illustration: CPU chip, registers, assembly and a hex dump"
              class="h-full w-full object-cover"
              width="800"
              height="1000"
              loading="eager"
            />
          </div>
        </div>

        <span class="float-badge hero-float left-0 top-10" style="animation-delay: 0.4s">
          <i><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="7" y="7" width="10" height="10" rx="2"/><path d="M10 4v3M14 4v3M10 17v3M14 17v3M4 10h3M4 14h3M17 10h3M17 14h3"/></svg></i>
          x86-64
        </span>
        <span class="float-badge hero-float right-0 top-28" style="animation-delay: 1.1s">
          <i><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8.66 5v10L12 22l-8.66-5V7z"/></svg></i>
          0x0
        </span>
        <span class="float-badge hero-float bottom-44 right-0" style="animation-delay: 1.8s">
          <i><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9l3 3-3 3M12 15h5"/></svg></i>
          syscall
        </span>
      </div>
    </div>
  </section>

  <!-- ============ POPULAR TAGS ============ -->
  {popularTags.length > 0 && (
    <section class="mt-24" data-animate style="animation-delay: 80ms">
      <h2 class="section-title">
        Popular <span class="accent">Tags</span>
      </h2>
      <div class="flex flex-wrap items-center justify-center gap-6">
        {popularTags.map(([tag, count]) => (
          <a href={`/blog/tag/${tag}`} class="tag-pill">
            <span class="tag-name">{tag}</span>
            <span class="post-count">{count} {count === 1 ? "post" : "posts"}</span>
          </a>
        ))}
        <a href="/blog/tags" class="tag-pill group">
          <span class="tag-name flex items-center gap-2">
            See all tags
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform duration-300 group-hover:translate-x-1"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
          <span class="post-count">{tagCounts.size} total</span>
        </a>
      </div>
    </section>
  )}

  <!-- ============ RECENT POSTS ============ -->
  {recent.length > 0 && (
    <section class="mt-24" data-animate style="animation-delay: 140ms">
      <h2 class="section-title">
        Recent <span class="accent">Posts</span>
      </h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {recent.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/blog" class="btn btn-lg">cat ./blog | more</a>
      </div>
    </section>
  )}

  <!-- ============ TERMINAL ============ -->
  <section class="esub-section" data-animate style="animation-delay: 200ms">
    <h2 class="esub-title text-3xl font-bold sm:text-4xl">
      Catch me tinkering in the terminal.
    </h2>
    <p class="esub-sub mx-auto mt-3 max-w-xl text-lg">
      A live look at what I'm learning — systems, tooling, and everything in between.
    </p>
    <div class="hero-term mx-auto text-left">
      <div class="term-head">
        <span class="dot dot-r"></span>
        <span class="dot dot-y"></span>
        <span class="dot dot-g"></span>
        <span class="term-title">rifki@dev: ~</span>
      </div>
      <div class="term-body">
        <div id="hero-term-content"></div>
        <div class="term-line">
          <span class="term-prompt">rifki@dev:~$</span>
          <span class="term-input" id="hero-term-input"></span>
          <span class="term-caret" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  </div>

</Layout>

<script>
// astro:page-load fires on first load AND on every view transition,
// so guard every initializer per-element to avoid double timers/listeners.
const boundInit = new WeakSet();

let typewriterTimer: number | undefined;

function initTypewriter() {
  const el = document.getElementById("typewriter");
  if (!el || boundInit.has(el)) return;
  boundInit.add(el);
  if (typewriterTimer) clearTimeout(typewriterTimer);
  const phrases: string[] = JSON.parse(el.dataset.phrases || "[]");
  let pi = 0;
  let ci = 0;
  let deleting = false;

  const tick = () => {
    const word = phrases[pi];
    el.textContent = word.slice(0, ci);
    let delay = deleting ? 35 : 70;
    if (!deleting && ci === word.length) {
      delay = 1600;
      deleting = true;
    } else if (deleting && ci === 0) {
      deleting = false;
      pi = (pi + 1) % phrases.length;
      delay = 350;
    } else {
      ci += deleting ? -1 : 1;
    }
    typewriterTimer = window.setTimeout(tick, delay);
  };

  if (phrases.length) tick();
}

function initTilt() {
  const wrap = document.querySelector("[data-tilt]") as HTMLElement | null;
  if (!wrap || boundInit.has(wrap)) return;
  boundInit.add(wrap);
  wrap.addEventListener("mousemove", (e) => {
    const r = wrap.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    const y = (e.clientY - r.top) / r.height - 0.5;
    wrap.style.transform = `perspective(900px) rotateY(${(x * 10).toFixed(2)}deg) rotateX(${(-y * 10).toFixed(2)}deg)`;
  });
  wrap.addEventListener("mouseleave", () => {
    wrap.style.transform = "";
  });
}

let termTimer: number | undefined;

function initHeroTerm() {
  const content = document.getElementById("hero-term-content");
  const input = document.getElementById("hero-term-input");
  if (!content || !input || boundInit.has(content)) return;
  boundInit.add(content);
  if (termTimer) clearTimeout(termTimer);
  content.innerHTML = "";
  input.textContent = "";
  const steps = [
    {
      cmd: "whoami",
      out: ['<span class="hl2">rifki</span> — cs student · terminal addict'],
    },
    {
      cmd: "ls ./learning",
      out: ['<span class="hl">c/</span>  <span class="hl">asm/</span>  <span class="hl">bash/</span>  <span class="hl">rust/</span>  <span class="hl">gdb/</span>  <span class="hl">docker/</span>'],
    },
    {
      cmd: "cat goal.txt",
      out: ['share what I learn, <span class="hl2">simply</span> &amp; <span class="hl2">enjoyably</span>'],
    },
  ];
  let step = 0;
  let ci = 0;

  const typeCmd = () => {
    const s = steps[step];
    if (ci <= s.cmd.length) {
      input.textContent = s.cmd.slice(0, ci++);
      termTimer = window.setTimeout(typeCmd, 55);
      return;
    }
    const div = document.createElement("div");
    div.className = "term-out";
    div.innerHTML = s.out.join("<br/>");
    content.appendChild(div);
    ci = 0;
    step = (step + 1) % steps.length;
    termTimer = window.setTimeout(() => {
      input.textContent = "";
      if (step === 0) content.innerHTML = "";
      typeCmd();
    }, 1500);
  };

  termTimer = window.setTimeout(typeCmd, 600);
}

document.addEventListener("DOMContentLoaded", () => {
  initTypewriter();
  initTilt();
  initHeroTerm();
});
document.addEventListener("astro:page-load", () => {
  initTypewriter();
  initTilt();
  initHeroTerm();
});
</script>