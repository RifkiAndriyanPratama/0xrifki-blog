---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { sortPosts } from "@/lib/utils";

const posts = sortPosts(await getCollection("posts"));
---

<Layout title="thestoriesrifki">

  <!-- Hero -->
  <section class="pt-16 pb-6 sm:pt-24 sm:pb-8" data-animate>
    <h1 class="text-4xl font-bold tracking-tight text-base-heading sm:text-5xl">
      thestoriesrifki
    </h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-base-subtle">
      cerita seputar coding, teknologi, dan hidup.
    </p>

    <!-- Search bar -->
    <button
      id="search-btn"
      class="mt-6 flex w-full max-w-md items-center gap-3 rounded-xl border border-base-overlay bg-base-bg-alt px-4 py-3 text-left text-sm text-base-muted transition-colors hover:border-base-teal"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0"><path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247Z"/></svg>
      <span>cari tulisan...</span>
      <kbd class="ml-auto hidden rounded border border-base-overlay px-1.5 py-0.5 text-xs text-base-muted sm:inline">⌘K</kbd>
    </button>
  </section>

  <!-- Divider -->
  <hr class="border-base-overlay" />

  <!-- Posts feed -->
  <section class="divide-y divide-base-overlay">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </section>

  {posts.length === 0 && (
    <div class="py-20 text-center">
      <p class="text-base-muted">belum ada tulisan.</p>
    </div>
  )}

</Layout>
