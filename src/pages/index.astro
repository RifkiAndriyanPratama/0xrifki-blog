---
// src/pages/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { sortPosts, readingTime, formatDate, isoDate, isFoto } from "@/lib/utils";
import { siteConfig } from "@/config/site";
import PostCover from "@/components/PostCover.astro";
import PhotoCard from "@/components/PhotoCard.astro";
import FrameCard from "@/components/FrameCard.astro";
import PostRow from "@/components/PostRow.astro";
import SidebarLeft from "@/components/SidebarLeft.astro";
import SidebarRight from "@/components/SidebarRight.astro";
import { tintBg } from "@/lib/tint";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

const posts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const featuredPost = posts[0];
const articles = posts.filter((p) => !isFoto(p));
const frames = posts.filter((p) => isFoto(p));
const latestPosts = (featuredPost && !isFoto(featuredPost) ? articles.filter((p) => p !== featuredPost) : articles).slice(0, 5);
const latestFrames = frames.slice(0, 6);
const popularPosts = [...posts]
  .sort((a, b) => b.data.readingTime - a.data.readingTime)
  .slice(0, 5);
const popularThreads = [...frames].slice(0, 3);

// Dominant colours per post, generated at build time (scripts/generate-og.mjs)
function loadPostColors(): Record<string, { from: number[]; to: number[] }> {
  try {
    return JSON.parse(readFileSync(new URL("../../public/post-colors.json", import.meta.url), "utf8"));
  } catch {
    return {};
  }
}
const postColors = loadPostColors();
const featuredTint = featuredPost ? postColors[featuredPost.slug] : undefined;
const featuredIsFoto = featuredPost ? isFoto(featuredPost) : false;

// Spec: bagian pertama judul featured diwarna aksen
const titleParts = featuredPost?.data.title.split(" ") ?? [];
const titleHead = titleParts[0] ?? "";
const titleRest = titleParts.slice(1).join(" ");

// Group by category
const categoryCounts = posts.reduce((acc, post) => {
  const cat = post.data.category;
  acc[cat] = (acc[cat] ?? 0) + 1;
  return acc;
}, {} as Record<string, number>);
const categories = Object.entries(categoryCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

// tags
const tagCounts = posts.reduce((acc, post) => {
  (post.data.tags ?? []).forEach((tag) => { acc[tag] = (acc[tag] ?? 0) + 1; });
  return acc;
}, {} as Record<string, number>);
const tags = Object.entries(tagCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
  .slice(0, 14);
---

<Layout title="thestoriesrifki">

  <div class="grid grid-cols-1 gap-10 py-8 sm:py-10 lg:grid-cols-[240px_minmax(0,1fr)_300px] lg:gap-12 lg:py-12">

    <!-- Kolom kiri -->
    <div class="hidden lg:block">
      <div class="lg:sticky lg:top-20">
        <SidebarLeft categories={categories} postCount={articles.length} threadCount={frames.length} />
      </div>
    </div>

    <!-- Kolom tengah -->
    <div class="flex min-w-0 flex-col gap-12">

      <!-- Featured -->
      {featuredPost && (
        <section data-animate>
          <h2 class="mb-4 text-xs font-semibold uppercase tracking-widest text-base-subtle">Postingan terbaik</h2>
          {featuredIsFoto ? (
            <PhotoCard post={featuredPost} tint={featuredTint} />
          ) : (
          <a href={`/blog/${featuredPost.slug}/`} class="card-hover group block overflow-hidden rounded-2xl border border-base-overlay bg-base-surface shadow-[var(--shadow-soft)]">
            <div class="h-44 overflow-hidden bg-gradient-to-r from-base-accent-light to-base-accent-light sm:h-52">
              {featuredTint ? (
                <div class="h-full w-full" style={{ background: tintBg(featuredTint) }}></div>
              ) : featuredPost.data.cover ? (
                <PostCover
                  src={featuredPost.data.cover}
                  alt={featuredPost.data.coverAlt ?? featuredPost.data.title}
                  mode="featured"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                />
              ) : null}
            </div>
            <div class="space-y-4 p-6 sm:p-8">
              <span class="inline-block rounded-full bg-base-bg-alt px-3 py-1 text-xs font-medium uppercase tracking-wider text-base-teal">
                {featuredPost.data.category}
              </span>
              <h1 class="hero-title font-serif leading-tight tracking-tight text-base-heading sm:text-3xl lg:text-4xl">
                {titleRest ? <>{titleHead} <span class="text-base-teal">{titleRest}</span></> : titleHead}
              </h1>
              <p class="max-w-2xl text-base leading-relaxed text-base-subtle sm:text-lg">
                {featuredPost.data.description}
              </p>
              <div class="flex items-center gap-3 border-t border-base-overlay pt-4 text-sm text-base-muted">
                <span class="font-medium text-base-heading">{siteConfig.name}</span>
                <span aria-hidden="true">·</span>
                <time datetime={isoDate(featuredPost.data.date)}>{formatDate(featuredPost.data.date)}</time>
                <span aria-hidden="true">·</span>
                <span>{featuredPost.data.readingTime ?? readingTime(featuredPost.body)} min read</span>
              </div>
            </div>
          </a>
          )}
        </section>
      )}

      <!-- Kategori populer sebagai pill -->
      {categories.length > 0 && (
        <section data-animate aria-label="Kategori populer">
          <div class="flex flex-wrap items-center gap-2">
            <span class="mr-1 text-xs font-semibold uppercase tracking-widest text-base-subtle">Topik:</span>
            {categories.slice(0, 4).map((cat) => (
              <a
                key={cat.name}
                href={`/blog/category/${cat.name}`}
                class="tag-chip text-xs capitalize"
                style="--tag-color:var(--color-teal)"
              >
                {cat.name}
                <span class="ml-1 text-[10px] text-base-muted">{cat.count}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Latest posts -->
      <section data-animate>
        <div class="mb-4 flex items-center justify-between">
          <h2 class="font-serif text-xl text-base-heading">Latest Posts</h2>
          <a href="/blog" class="text-sm font-medium text-base-teal transition-colors hover:underline">Lihat semua →</a>
        </div>
        <div class="flex flex-col gap-4">
          {latestPosts.map((post) => <PostRow post={post} />)}
        </div>
      </section>

      <!-- Latest Frames -->
      {latestFrames.length > 0 && (
        <section data-animate>
          <div class="mb-4 flex items-center justify-between">
            <h2 class="font-serif text-xl text-base-heading">📸 Latest Frames</h2>
            <a href="/frames" class="text-sm font-medium text-base-teal transition-colors hover:underline">Lihat semua →</a>
          </div>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
            {latestFrames.map((thread) => <FrameCard thread={thread} />)}
          </div>
        </section>
      )}

      <!-- Jelajahi (mobile saja): kategori & tag dalam accordion -->
      <section class="lg:hidden" data-animate>
        <details class="rounded-2xl border border-base-overlay bg-base-surface p-4" open={false}>
          <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold text-base-heading">
            Jelajahi
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-transform duration-200 [details[open]_&]:rotate-180"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {categories.map((cat) => (
              <a href={`/blog/category/${cat.name}`} class="tag-chip text-xs capitalize" style="--tag-color:var(--color-teal)">
                {cat.name}
                <span class="ml-1 text-[10px] text-base-muted">{cat.count}</span>
              </a>
            ))}
          </div>
          {tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-1.5">
              {tags.map((t) => (
                <a href={`/search?q=${encodeURIComponent(t.name)}`} class="tag-chip text-xs" style="--tag-color:var(--color-blue)">
                  #{t.name}
                </a>
              ))}
            </div>
          )}
        </details>
      </section>

    </div>

    <!-- Kolom kanan (tablet: full-width 2-kolom di bawah konten) -->
    <div class="hidden min-w-0 md:block lg:sticky lg:top-20">
      <SidebarRight popularPosts={popularPosts} popularThreads={popularThreads} tags={tags} />
    </div>

  </div>

</Layout>