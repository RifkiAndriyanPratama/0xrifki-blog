---
// src/pages/404.astro
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 — page not found">
  <div class="flex flex-col items-center justify-center py-24 text-center" data-animate>
    <p class="font-code mb-4 text-sm text-base-muted">error</p>
    <h1 class="text-7xl font-bold text-gradient md:text-8xl">404</h1>
    <p class="mt-4 text-lg text-base-subtle">halaman yang kamu cari tidak ditemukan.</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn">
        ~/home →
      </a>
      <a href="/blog" class="btn-ghost">
        /blog
      </a>
      <a href="/projects" class="btn-ghost">
        /projects
      </a>
    </div>

    <pre class="mt-12 text-left font-code text-xs text-base-muted">
      <code>
  $ curl -s https://0xrifki-blog.vercel.app/this-path
  &gt; 404 Not Found
  Segmentation fault (core dumped)
  $ echo $?
  <span class="text-teal">139</span></code>
    </pre>
  </div>
</Layout>