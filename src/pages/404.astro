---
// src/pages/404.astro
import Layout from "@/layouts/Layout.astro";
---

<Layout title="404 · halaman tidak ditemukan">
  <div class="flex flex-col items-center justify-center py-24 text-center" data-animate>
    <p class="font-code mb-4 text-sm text-base-muted">oops</p>
    <h1 class="text-7xl font-bold text-gradient md:text-8xl">404</h1>
    <p class="mt-4 text-lg text-base-subtle">halaman yang kamu cari tidak ditemukan.</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn">
        Kembali ke Beranda
      </a>
      <a href="/blog" class="btn-ghost">
        Blog
      </a>
    </div>
  </div>
</Layout>
