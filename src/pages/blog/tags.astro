---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getTags } from "@/lib/utils";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getTags(posts);
const tagCounts = Object.entries(
  tags.reduce((acc, tag) => {
    acc[tag] = posts.filter((p) => !p.data.draft && p.data.tags.includes(tag)).length;
    return acc;
  }, {} as Record<string, number>)
).sort((a, b) => b[1] - a[1]);
---

<Layout title="tags" description="All tags used on this blog.">
  <header class="py-10 text-center" data-animate>
    <h1 class="text-4xl font-bold tracking-tight text-base-heading md:text-5xl">
      <span class="text-gradient">Tags</span>
    </h1>
    <p class="mt-3 text-lg text-base-subtle">{tags.length} tags</p>
  </header>

  <div class="mx-auto mt-14 flex max-w-3xl flex-wrap justify-center gap-3" data-animate style="animation-delay: 60ms">
    {tagCounts.map(([tag, count]) => (
      <a
        href={`/blog/tag/${tag}`}
        class="tag-chip"
        style="--tag-color: #5fedac"
      >
        #{tag}
        <span class="ml-1 text-xs opacity-70">{count}</span>
      </a>
    ))}
  </div>
</Layout>