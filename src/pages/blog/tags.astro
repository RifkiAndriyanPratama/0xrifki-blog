---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { getTags } from "@/lib/utils";

const posts = await getCollection("posts");
const tags = getTags(posts);
const tagCounts = Object.entries(
  tags.reduce((acc, tag) => {
    acc[tag] = posts.filter((p) => !p.data.draft && p.data.tags.includes(tag)).length;
    return acc;
  }, {} as Record<string, number>)
).sort((a, b) => b[1] - a[1]);
---

<Layout title="tags" description="All tags used on this blog.">
  <div data-animate>
    <h1 class="font-code mb-2 text-2xl font-medium text-base-teal">
      <span class="text-base-subtle">~/</span>tags
    </h1>
    <p class="font-code text-sm text-base-muted">{tags.length} tags</p>
  </div>

  <div class="mt-10 flex flex-wrap gap-3" data-animate>
    {tagCounts.map(([tag, count]) => (
      <a
        href={`/blog/tag/${tag}`}
        class="group font-code inline-flex items-center gap-1.5 rounded-lg border border-base-overlay px-3 py-1.5 text-sm text-base-subtle transition-colors hover:border-base-teal hover:text-base-teal"
      >
        #{tag}
        <span class="text-xs text-base-muted group-hover:text-base-teal/60">{count}</span>
      </a>
    ))}
  </div>
</Layout>
