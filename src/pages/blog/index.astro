---
// src/pages/blog/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import { sortPosts, readingTime, formatDate, isoDate } from "@/lib/utils";

const posts = sortPosts(await getCollection("posts"));
const total = posts.length;

const categories = posts.reduce((acc, post) => {
  const cat = post.data.category;
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(post);
  return acc;
}, {} as Record<string, typeof posts>);
---

<Layout title="Semua Tulisan" description={`Semua ${total} tulisan di blog.`}>

  <header class="pt-10 pb-6" data-animate>
    <a href="/" class="mb-4 inline-block text-sm text-base-muted transition-colors hover:text-base-teal">← kembali</a>
    <h1 class="font-serif text-3xl font-bold tracking-tight text-base-heading sm:text-4xl">
      Semua Tulisan
    </h1>
    <p class="mt-2 text-base text-base-subtle">{total} tulisan</p>
  </header>

  <hr class="border-base-overlay" />

  <!-- Category filter -->
  <section class="flex flex-wrap gap-2 py-6" data-animate>
    {Object.keys(categories).map((cat) => (
      <a
        href={`/blog/category/${cat}`}
        class="rounded-full border border-base-overlay px-4 py-1.5 text-sm text-base-subtle transition-colors hover:border-base-teal hover:text-base-teal"
      >
        {cat}
      </a>
    ))}
  </section>

  <hr class="border-base-overlay" />

  <!-- Posts list -->
  <section class="flex flex-col divide-y divide-base-overlay">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}/`} class="group flex items-start gap-4 py-5">
        <div class="min-w-0 flex-1">
          <div class="mb-1.5 flex items-center gap-2 text-xs text-base-muted">
            <span class="rounded-full border border-base-overlay px-2 py-0.5 capitalize">{post.data.category}</span>
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{post.data.readingTime ?? readingTime(post.body)} min</span>
          </div>
          <h2 class="text-lg font-semibold text-base-heading leading-snug transition-colors group-hover:text-base-teal">
            {post.data.title}
          </h2>
          <p class="mt-1 text-sm text-base-subtle line-clamp-2 leading-relaxed">{post.data.description}</p>
        </div>
        {post.data.cover && (
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? post.data.title}
            class="h-20 w-20 shrink-0 rounded-xl object-cover"
            width={80}
            height={80}
            loading="lazy"
          />
        )}
      </a>
    ))}
  </section>

  {posts.length === 0 && (
    <div class="py-20 text-center">
      <p class="text-base-muted">belum ada tulisan.</p>
    </div>
  )}

</Layout>
