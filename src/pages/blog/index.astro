---
// src/pages/blog/index.astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { sortPosts } from "@/lib/utils";

const posts = sortPosts(await getCollection("posts"));
const total = posts.length;
---

<Layout title="Blog" description={`Semua ${total} tulisan di blog.`}>
  <header class="pt-10 pb-6 text-center" data-animate>
    <h1 class="text-4xl font-bold tracking-tight text-base-heading md:text-5xl">Blog</h1>
    <p class="mt-3 text-lg text-base-subtle">
      {total} tulisan
    </p>
  </header>

  <hr class="border-base-overlay" />

  <section class="divide-y divide-base-overlay">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </section>

  {posts.length === 0 && (
    <div class="py-20 text-center">
      <p class="text-base-muted">belum ada tulisan.</p>
    </div>
  )}
</Layout>
