---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { sortPosts } from "@/lib/utils";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((p) => p.data.category))].sort();
  return categories.map((cat) => ({
    params: { category: cat },
    props: { category: cat },
  }));
};

const { category } = Astro.props;
const allPosts = sortPosts(await getCollection("posts"));
const posts = allPosts.filter((p) => p.data.category === category);
---

<Layout title={`${category}`} description={`Posts about ${category}.`}>
  <header class="py-10 text-center" data-animate>
    <h1 class="text-4xl font-bold tracking-tight text-base-heading md:text-5xl">
      <span class="text-gradient">{category}</span>
    </h1>
    <p class="mt-3 text-lg text-base-subtle">{posts.length} entries</p>
  </header>

  <div class="mt-14 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3" data-animate style="animation-delay: 60ms">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Layout>