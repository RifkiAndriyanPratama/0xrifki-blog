---
// src/pages/blog/category/[category].astro
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import { sortPosts, readingTime, formatDate, isoDate } from "@/lib/utils";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((p) => p.data.category))].sort();
  return categories.map((cat) => ({
    params: { category: cat },
    props: { category: cat },
  }));
};

const { category } = Astro.props;
const allPosts = sortPosts(await getCollection("posts"));
const posts = allPosts.filter((p) => p.data.category === category);

const allCategories = [...new Set(allPosts.map((p) => p.data.category))].sort();
---

<Layout title={`Tulisan tentang ${category}`} description={`Kumpulan tulisan tentang ${category}.`}>

  <header class="pt-10 pb-6" data-animate>
    <a href="/blog" class="mb-4 inline-block text-sm text-base-muted transition-colors hover:text-base-teal">← semua tulisan</a>
    <h1 class="font-serif text-3xl font-bold tracking-tight text-base-heading sm:text-4xl capitalize">
      {category}
    </h1>
    <p class="mt-2 text-base text-base-subtle">{posts.length} tulisan</p>
  </header>

  <hr class="border-base-overlay" />

  <!-- Category navigation -->
  <section class="flex flex-wrap gap-2 py-6" data-animate>
    {allCategories.map((cat) => (
      <a
        href={`/blog/category/${cat}`}
        class:list={[
          "rounded-full border px-4 py-1.5 text-sm transition-colors",
          cat === category
            ? "border-base-teal bg-base-teal/10 font-medium text-base-teal"
            : "border-base-overlay text-base-subtle hover:border-base-teal hover:text-base-teal",
        ]}
      >
        {cat}
      </a>
    ))}
  </section>

  <hr class="border-base-overlay" />

  <!-- Posts list -->
  <section class="flex flex-col gap-4 py-6">
    {posts.map((post) => (
      <a href={`/blog/${post.slug}/`} class="group flex items-start gap-4 rounded-2xl border border-base-overlay p-5 transition-all hover:border-base-teal hover:shadow-sm">
        <div class="min-w-0 flex-1">
          <div class="mb-1.5 flex items-center gap-2 text-xs text-base-muted">
            <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
            <span aria-hidden="true">·</span>
            <span>{post.data.readingTime ?? readingTime(post.body)} min</span>
          </div>
          <h2 class="text-lg font-semibold text-base-heading leading-snug transition-colors group-hover:text-base-teal">
            {post.data.title}
          </h2>
          <p class="mt-1 text-sm text-base-subtle line-clamp-2 leading-relaxed">{post.data.description}</p>
        </div>
        {post.data.cover && (
          <Image
            src={post.data.cover}
            alt={post.data.coverAlt ?? post.data.title}
            class="h-20 w-20 shrink-0 rounded-xl object-cover"
            width={80}
            height={80}
            loading="lazy"
          />
        )}
      </a>
    ))}
  </section>

  {posts.length === 0 && (
    <div class="py-20 text-center">
      <p class="text-base-muted">belum ada tulisan di kategori ini.</p>
    </div>
  )}

</Layout>
