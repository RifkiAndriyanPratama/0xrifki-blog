---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { sortPosts } from "@/lib/utils";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const categories = [...new Set(posts.map((p) => p.data.category))].sort();
  return categories.map((cat) => ({
    params: { category: cat },
    props: { category: cat },
  }));
};

const { category } = Astro.props;
const allPosts = sortPosts(await getCollection("posts"));
const posts = allPosts.filter((p) => p.data.category === category);
---

<Layout title={`${category}`} description={`Posts about ${category}.`}>
  <div data-animate>
    <h1 class="mb-2 text-2xl font-medium text-base-text">
      <span class="text-base-teal">{category}</span>
    </h1>
    <p class="text-sm text-base-muted">{posts.length} entries</p>
  </div>

  <div class="mt-12 space-y-8">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</Layout>
