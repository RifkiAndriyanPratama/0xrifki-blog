---
// src/layouts/PostLayout.astro
// Wraps Layout.astro with post-specific chrome: header, cover image, metadata,
// TOC, reading progress, prev/next nav, related posts, series, share, comments.
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCard from "@/components/PostCard.astro";
import { Image } from "astro:assets";
import { formatDate, isoDate, readingTime, sortPosts } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, date, category, tags, cover, coverAlt, updated, series, seriesOrder } = post.data;
const readTime = post.data.readingTime ?? readingTime(post.body);

const ogImage = cover
  ? new URL(cover.src, Astro.site).toString()
  : undefined;

// ── Prev / Next ──────────────────────────────────────────────────────────────
const allPosts = sortPosts(await getCollection("posts"));
const currentIdx = allPosts.findIndex((p) => p.slug === post.slug);
const prev = currentIdx > 0 ? allPosts[currentIdx - 1] : null;
const next = currentIdx < allPosts.length - 1 ? allPosts[currentIdx + 1] : null;

// ── Related Posts (same category, exclude current, max 3) ────────────────────
const related = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === category)
  .slice(0, 3);

// ── Series Posts ─────────────────────────────────────────────────────────────
const seriesPosts = series
  ? allPosts
      .filter((p) => p.data.series === series)
      .sort((a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99))
  : [];
const seriesIdx = seriesPosts.findIndex((p) => p.slug === post.slug);
---

<Layout title={title} description={description} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "datePublished": isoDate(date),
    ...(updated && { "dateModified": isoDate(updated) }),
    "author": {
      "@type": "Person",
      "name": "Rifki Andriyan Pratama",
    },
  })} />

  <!-- ── Reading Progress Bar ────────────────────────────────────────────── -->
  <div id="reading-bar" class="fixed left-0 top-0 z-[60] h-1 bg-base-teal transition-[width] duration-75"></div>

  <article>
    <div class="mx-auto w-full max-w-5xl">

      <!-- ── Header ──────────────────────────────────────────────────────── -->
      <header class="mb-14">
        <div class="flex flex-wrap items-center gap-2 mb-5">
          <a
            href={`/blog/category/${category}`}
            class="inline-block rounded border border-base-overlay px-2 py-0.5 text-xs text-base-blue transition-colors hover:border-base-blue"
          >
            {category}
          </a>
          {post.data.featured && (
            <span class="inline-block rounded border border-base-yellow/40 px-2 py-0.5 text-xs text-base-yellow">
              ★ Featured
            </span>
          )}
        </div>

        <h1 class="font-code text-3xl font-semibold leading-tight tracking-tight text-base-text md:text-4xl">
          {title}
        </h1>

        <p class="mt-4 text-lg text-base-subtle">{description}</p>

        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-base-muted">
          <time datetime={isoDate(date)}>
            {formatDate(date)}
          </time>
          {updated && isoDate(updated) !== isoDate(date) && (
            <>
              <span aria-hidden="true">·</span>
              <span>updated {formatDate(updated)}</span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{readTime} min read</span>
        </div>

        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2 text-sm text-base-subtle">
            {tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- ── Series nav ──────────────────────────────────────────────────── -->
      {seriesPosts.length > 1 && (
        <div class="mb-10 rounded-lg border border-base-overlay bg-base-surface p-4">
          <p class="font-code text-xs font-medium uppercase tracking-wider text-base-muted">
            Series: {series}
          </p>
          <p class="font-code text-xs text-base-subtle mt-1">
            Part {seriesIdx + 1} of {seriesPosts.length}
          </p>
          <ol class="mt-3 space-y-1">
            {seriesPosts.map((p, i) => (
              <li>
                {p.slug === post.slug ? (
                  <span class="font-code text-xs text-base-teal">
                    {i + 1}. {p.data.title}
                  </span>
                ) : (
                  <a
                    href={`/blog/${p.slug}`}
                    class="font-code text-xs text-base-muted transition-colors hover:text-base-teal"
                  >
                    {i + 1}. {p.data.title}
                  </a>
                )}
              </li>
            ))}
          </ol>
        </div>
      )}

      <!-- ── Cover ────────────────────────────────────────────────────────── -->
      {cover && (
        <div class="mb-10 overflow-hidden rounded-lg border border-base-overlay">
          <Image
            src={cover}
            alt={coverAlt ?? title}
            class="w-full object-cover"
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 768px, 100vw"
            loading="eager"
          />
        </div>
      )}

      <!-- ── TOC ──────────────────────────────────────────────────────────── -->
      <details class="mb-10 rounded-lg border border-base-overlay" id="toc-component">
        <summary class="cursor-pointer px-4 py-2.5 font-code text-sm text-base-muted transition-colors hover:text-base-text">
          Table of Contents
        </summary>
        <nav class="border-t border-base-overlay px-4 py-3" id="toc-content"></nav>
      </details>

      <!-- ── Content ──────────────────────────────────────────────────────── -->
      <div class="prose prose-devlog max-w-4xl mx-auto">
        <slot />
      </div>

      <!-- ── Post Footer ──────────────────────────────────────────────────── -->
      <footer class="mt-16 md:mt-20 border-t border-base-overlay pt-8">
        <!-- Tags -->
        {tags.length > 0 && (
          <div class="mb-8 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/blog/tag/${tag}`}
                class="font-code rounded border border-base-overlay px-2 py-0.5 text-xs text-base-subtle transition-colors hover:border-base-subtle hover:text-base-text"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <!-- Share -->
        <div class="mb-8 flex flex-wrap items-center gap-3">
          <span class="font-code text-xs text-base-muted">share</span>
          <a id="share-twitter" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-lg border border-base-overlay px-3 py-1.5 font-code text-xs text-base-muted transition-colors hover:border-base-blue hover:text-base-blue" aria-label="Share on Twitter/X">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            X
          </a>
          <a id="share-linkedin" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 rounded-lg border border-base-overlay px-3 py-1.5 font-code text-xs text-base-muted transition-colors hover:border-base-blue hover:text-base-blue" aria-label="Share on LinkedIn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
          <button id="share-btn-footer" class="flex items-center gap-1.5 rounded-lg border border-base-overlay px-3 py-1.5 font-code text-xs text-base-muted transition-colors hover:border-base-teal hover:text-base-teal" aria-label="Copy link to this post">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
            <span>copy link</span>
          </button>
        </div>

        <!-- Prev / Next -->
        <nav class="mb-8 grid grid-cols-1 gap-4 border-y border-base-overlay py-6 sm:grid-cols-2">
          <div>
            {prev && (
              <a href={`/blog/${prev.slug}`} class="group flex flex-col gap-1 rounded-lg border border-base-overlay p-4 transition-colors hover:border-base-teal">
                <span class="font-code text-xs text-base-muted">← Previous</span>
                <span class="font-medium text-base-text transition-colors group-hover:text-base-teal">
                  {prev.data.title}
                </span>
              </a>
            )}
          </div>
          <div class="sm:text-right">
            {next && (
              <a href={`/blog/${next.slug}`} class="group flex flex-col gap-1 rounded-lg border border-base-overlay p-4 transition-colors hover:border-base-teal">
                <span class="font-code text-xs text-base-muted">Next →</span>
                <span class="font-medium text-base-text transition-colors group-hover:text-base-teal">
                  {next.data.title}
                </span>
              </a>
            )}
          </div>
        </nav>

        <!-- Related Posts -->
        {related.length > 0 && (
          <div class="mb-8">
            <h2 class="mb-4 text-sm font-medium text-base-muted">
              Related Posts
            </h2>
            <div class="space-y-4">
              {related.map((p) => <PostCard post={p} />)}
            </div>
          </div>
        )}

        <!-- Back link -->
        <a href="/blog" class="font-code text-xs text-base-muted underline underline-offset-4 transition-colors hover:text-base-text">
          ← back to posts
        </a>
      </footer>

      <!-- ── Comments ────────────────────────────────────────────────────────── -->
      <section class="mt-16 md:mt-20" aria-label="Comments">
        <div id="giscus-container" class="w-full min-w-0 overflow-hidden">
          <script is:inline src="https://giscus.app/client.js"
            data-repo="RifkiAndriyanPratama/0xrifki-blog"
            data-repo-id="R_kgDORfQbeg"
            data-category="Blog Comments"
            data-category-id="DIC_kwDORfQbes4C3wB_"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="transparent_dark"
            data-lang="en"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          ></script>
        </div>
      </section>

    </div>
  </article>
</Layout>

<script is:inline>
  // ── Cleanup guard — prevent stale listeners accumulating on View Transitions
  let activeTOCListener = null;

  function initPost() {
    // Use the article inside the <main> to be sure we target the right page content
    const article = document.querySelector("main article");
    if (!article) return;

    // ── Reading progress bar ──────────────────────────────────────────────
    const bar = document.getElementById("reading-bar");
    if (bar) {
      // Remove duplicate listeners by storing a named function reference
      const onScroll = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          bar.style.width = `${(scrollTop / docHeight) * 100}%`;
        }
      };
      window.removeEventListener("scroll", bar._onScroll);
      window.addEventListener("scroll", onScroll, { passive: true });
      bar._onScroll = onScroll;
    }

    // ── Table of Contents ─────────────────────────────────────────────────
    const tocContainer = document.getElementById("toc-content");
    const tocEl = document.getElementById("toc-component");
    if (tocContainer) tocContainer.innerHTML = "";

    const headings = article.querySelectorAll("h2, h3");
    const hasTOC = headings.length >= 4;

    if (!hasTOC) {
      tocEl?.remove();
      return;
    }

    const tocLinks = [];

    if (tocContainer) {
      const ul = document.createElement("ul");
      ul.className = "space-y-1";

      headings.forEach((h) => {
        const id = h.id || h.textContent
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-|-$/g, "");

        h.id = id;

        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = `#${id}`;
        a.textContent = h.textContent;
        a.className =
          "block truncate text-sm transition-colors hover:text-base-teal" +
          (h.tagName === "H3" ? " pl-4 text-base-muted" : " text-base-subtle");
        li.appendChild(a);
        ul.appendChild(li);
        tocLinks.push(a);
      });

      tocContainer.appendChild(ul);
    }

    // ── TOC scroll spy ────────────────────────────────────────────────────
    // Remove previous scroll spy listener to avoid duplicates
    if (activeTOCListener) {
      window.removeEventListener("scroll", activeTOCListener);
      activeTOCListener = null;
    }

    function updateActiveTOC() {
      let currentIdx = -1;
      const scrollY = window.scrollY + 120;

      headings.forEach((h, i) => {
        if (h.offsetTop <= scrollY) currentIdx = i;
      });

      tocLinks.forEach((a, i) => {
        const isActive = i === currentIdx;
        a.classList.toggle("text-base-teal", isActive);
        a.classList.toggle("font-medium", isActive);
        if (!isActive) {
          a.classList.remove("text-base-teal", "font-medium");
        }
      });
    }

    activeTOCListener = updateActiveTOC;
    window.addEventListener("scroll", updateActiveTOC, { passive: true });
    updateActiveTOC();

    // ── Share / Copy link ────────────────────────────────────────────────
    const shareBtn = document.getElementById("share-btn");
    if (shareBtn) {
      shareBtn.addEventListener("click", async () => {
        const url = window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          shareBtn.textContent = "copied!";
          setTimeout(() => { shareBtn.textContent = "copy link"; }, 2000);
        } catch {
          shareBtn.textContent = "failed";
        }
      });
    }

    // ── Social share buttons ─────────────────────────────────────────────
    const pageUrl = encodeURIComponent(window.location.href);
    const pageTitle = encodeURIComponent(document.title.replace(/ — .*$/, ""));
    const twitter = document.getElementById("share-twitter");
    const linkedin = document.getElementById("share-linkedin");
    if (twitter) twitter.href = `https://twitter.com/intent/tweet?text=${pageTitle}&url=${pageUrl}`;
    if (linkedin) linkedin.href = `https://linkedin.com/sharing/share-offsite/?url=${pageUrl}`;

    const footerShare = document.getElementById("share-btn-footer");
    if (footerShare) {
      footerShare.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(decodeURIComponent(pageUrl));
          const span = footerShare.querySelector("span");
          if (span) { span.textContent = "copied!"; setTimeout(() => { span.textContent = "copy link"; }, 2000); }
        } catch {
          const span = footerShare.querySelector("span");
          if (span) span.textContent = "failed";
        }
      });
    }

    // ── Code copy buttons ───────────────────────────────────────────────
    document.querySelectorAll(".astro-code").forEach((block) => {
      const wrapper = block.closest("[class*='language-']") || block.parentElement;
      if (wrapper && wrapper.querySelector(".copy-btn")) return;

      const btn = document.createElement("button");
      btn.className = "copy-btn";
      btn.textContent = "copy";
      btn.setAttribute("aria-label", "Copy code to clipboard");

      btn.addEventListener("click", async () => {
        const code = block.querySelector("code")?.textContent || block.textContent;
        try {
          await navigator.clipboard.writeText(code.trim());
          btn.textContent = "copied!";
          setTimeout(() => { btn.textContent = "copy"; }, 2000);
        } catch {
          btn.textContent = "failed";
        }
      });

      const header = wrapper.querySelector(".code-header");
      if (header) {
        header.appendChild(btn);
      } else if (wrapper instanceof HTMLElement) {
        const lang = Array.from(wrapper.classList).find(c => c.startsWith("language-"))?.replace("language-", "") || "code";
        const hdr = document.createElement("div");
        hdr.className = "code-header";
        hdr.innerHTML = `<span>${lang}</span>`;
        hdr.appendChild(btn);
        wrapper.insertBefore(hdr, block);
      }
    });

    // ── Smooth anchor scrolling with header offset ──────────────────────
    document.querySelectorAll("a[href^='#']").forEach((anchor) => {
      anchor.addEventListener("click", (e) => {
        const id = anchor.getAttribute("href")?.slice(1);
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          const offset = 100;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: "smooth" });
          history.pushState(null, "", `#${id}`);
        }
      });
    });

    // ── Image lightbox ──────────────────────────────────────────────────
    document.querySelectorAll(".prose img").forEach((img) => {
      if (img.closest("a")) return;
      img.style.cursor = "zoom-in";
      img.addEventListener("click", () => {
        const prevActive = document.activeElement;

        const overlay = document.createElement("div");
        overlay.className = "fixed inset-0 z-[200] flex items-center justify-center bg-black/70 backdrop-blur-sm cursor-zoom-out";
        overlay.setAttribute("role", "dialog");
        overlay.setAttribute("aria-modal", "true");
        overlay.setAttribute("aria-label", "Image preview");

        const full = document.createElement("img");
        full.src = img.src;
        full.alt = img.alt || "";
        full.className = "max-h-[90vh] max-w-[90vw] rounded-lg shadow-2xl";

        const close = document.createElement("button");
        close.className = "absolute top-4 right-4 text-white/70 hover:text-white transition-colors";
        close.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
        close.setAttribute("aria-label", "Close image");

        overlay.appendChild(full);
        overlay.appendChild(close);

        function cleanup() {
          overlay.remove();
          document.body.style.overflow = "";
          document.removeEventListener("keydown", onKeydown);
          prevActive?.focus();
        }

        overlay.addEventListener("click", (e) => {
          if (e.target === overlay || e.target === close) cleanup();
        });

        function onKeydown(e) {
          if (e.key === "Escape") cleanup();
          if (e.key === "Tab") {
            const focusable = overlay.querySelectorAll('button, [href], input, [tabindex]:not([tabindex="-1"])');
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last?.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first?.focus();
            }
          }
        }
        document.addEventListener("keydown", onKeydown);

        document.body.appendChild(overlay);
        document.body.style.overflow = "hidden";
        close.focus();
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initPost);
  document.addEventListener("astro:page-load", initPost);
</script>
