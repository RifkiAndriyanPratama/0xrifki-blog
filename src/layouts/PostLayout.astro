---
// src/layouts/PostLayout.astro
// Desktop: content (left) + sticky sidebar author card (right)
// Mobile: single column
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import PostCover from "@/components/PostCover.astro";
import PhotoCarousel from "@/components/PhotoCarousel.astro";
import { formatDate, isoDate, readingTime, sortPosts } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, date, category, tags, cover, coverAlt, updated, lang } = post.data;
const isFoto = post.data.type === "foto";
const gallery = post.data.photos ?? [];
const lead = isFoto ? gallery[0] : cover;
const readTime = post.data.readingTime ?? readingTime(post.body);

const ogImage = lead
  ? typeof lead === "string"
    ? new URL(lead, Astro.site).toString()
    : new URL(lead.src, Astro.site).toString()
  : new URL(`/og/${post.slug}.png`, Astro.site).toString();

const allPosts = sortPosts(await getCollection("posts", ({ data }) => !data.draft));
const sameCategory = allPosts.filter((p) => p.slug !== post.slug && p.data.category === category);
const otherPosts = sameCategory.length >= 3
  ? sameCategory.slice(0, 5)
  : [...sameCategory, ...allPosts.filter((p) => p.slug !== post.slug && p.data.category !== category)].slice(0, 5);
---

<Layout title={title} description={description} ogImage={ogImage} lang={lang} immersive
    ogType="article"
    publishedTime={isoDate(date)}
    modifiedTime={updated ? isoDate(updated) : undefined}
    author="Rifki Andriyan Pratama">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": isFoto ? "Photograph" : "Article",
    "headline": title,
    "description": description,
    ...(lead ? (typeof lead === "string" ? { "image": new URL(lead, Astro.site).toString() } : { "image": new URL(lead.src, Astro.site).toString() }) : {}),
    "datePublished": isoDate(date),
    ...(updated && { "dateModified": isoDate(updated) }),
    "author": {
      "@type": "Person",
      "name": "Rifki Andriyan Pratama",
    },
  })} />

  <div id="reading-bar" class="fixed left-0 top-0 z-[60] h-1 bg-base-teal transition-[width] duration-75"></div>

  <!-- Mode baca fokus (sepia) -->
  <button
    id="sepia-toggle"
    class="fixed bottom-[8.5rem] right-1 z-[55] flex h-10 w-10 items-center justify-center rounded-full border border-base-overlay bg-base-surface text-base-subtle transition-colors hover:border-base-teal hover:text-base-heading sm:bottom-[10.5rem] sm:right-2"
    aria-label="Mode baca fokus (sepia)"
    title="Mode baca fokus"
  >
    <span class="font-serif text-sm font-bold">Aa</span>
  </button>

  <!-- Desktop: two-column layout -->
  <div class="lg:flex lg:justify-center lg:gap-16">

    <!-- Main content column -->
    <article class="max-w-[680px] lg:px-0">

      <!-- Back link -->
      <nav class="pt-8 pb-4 sm:pt-10 sm:pb-6" aria-label="Breadcrumb">
        <a href="/blog" data-back-link class="inline-flex items-center gap-1.5 text-sm text-base-muted transition-colors hover:text-base-heading">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span data-back-label>semua tulisan</span>
        </a>
      </nav>

      <!-- Header -->
      <header class="mb-6 sm:mb-8">
        <h1 class="font-serif text-2xl font-bold leading-tight tracking-tight text-base-heading sm:text-[1.75rem] lg:text-[2.75rem] lg:leading-[1.1]">
          {title}
        </h1>

        <div class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-base-muted sm:mt-3 sm:gap-2 sm:text-[13px]">
          <span class="font-medium text-base-subtle">Rifki Andriyan Pratama</span>
          <span aria-hidden="true">·</span>
          <time datetime={isoDate(date)}>{formatDate(date)}</time>
          {updated && isoDate(updated) !== isoDate(date) && (
            <>
              <span aria-hidden="true">·</span>
              <span>updated {formatDate(updated)}</span>
            </>
          )}
          {isFoto && gallery.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <span>{gallery.length} foto</span>
            </>
          )}
          {!isFoto && (
            <>
              <span aria-hidden="true">·</span>
              <span>{readTime} min read</span>
            </>
          )}
        </div>
      </header>

      {isFoto ? (
        <>
          {description && (
            <p class="mb-4 text-lg leading-relaxed text-base-subtle sm:text-xl">{description}</p>
          )}
          <div class="prose">
            <slot />
          </div>
          {gallery.length > 0 && (
            <div class="mt-8">
              <PhotoCarousel photos={gallery} alt={coverAlt ?? title} />
            </div>
          )}
        </>
      ) : (
        <>
          {lead && (
            <div class="mb-6 sm:mb-8">
              <PostCover
                src={lead}
                alt={coverAlt ?? title}
                mode="hero"
                class="w-full rounded object-cover"
              />
            </div>
          )}
          <div class="prose">
            <slot />
          </div>
        </>
      )}

      <!-- Divider -->
      <div class="my-8 border-t border-base-overlay sm:my-12"></div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mb-8 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="tag-chip">{tag}</span>
          ))}
        </div>
      )}

      <!-- Back -->
      <a href="/blog" data-back-link class="inline-block text-sm text-base-muted underline underline-offset-4 transition-colors hover:text-base-heading mb-16">
        ← <span data-back-label>semua tulisan</span>
      </a>

    </article>

    <!-- Sidebar (desktop only, sticky) -->
    <aside class="hidden lg:block lg:w-[300px] lg:sticky lg:top-24 lg:self-start">
      <div class="flex flex-col items-start gap-6">

        <!-- Author -->
        <div class="flex items-center gap-3">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-base-accent-light font-serif font-bold text-base-heading text-sm">
            R
          </div>
          <div>
            <p class="text-sm font-semibold text-base-heading">Rifki Andriyan Pratama</p>
            <p class="text-xs text-base-muted">Penulis</p>
          </div>
        </div>

        <!-- Share -->
        <div class="flex items-center gap-2">
          <a id="share-twitter" href="#" target="_blank" rel="noopener noreferrer"
             class="share-circle"
             aria-label="Share on X">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a id="share-linkedin" href="#" target="_blank" rel="noopener noreferrer"
             class="share-circle"
             aria-label="Share on LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <button id="share-btn-footer" class="share-circle" aria-label="Copy link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
          </button>
        </div>

        <!-- ToC -->
        <div id="toc" class="hidden w-full border-t border-base-overlay pt-6">
          <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-base-muted">Di halaman ini</p>
          <ol id="toc-list" class="flex flex-col gap-1"></ol>
        </div>

        <!-- Other posts -->
        {otherPosts.length > 0 && (
          <div class="w-full border-t border-base-overlay pt-6">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-base-muted">Tulisan lainnya</p>
            <ul class="flex flex-col gap-1">
              {otherPosts.map((p) => (
                <li>
                  <a href={`/blog/${p.slug}`} class="group block rounded-lg px-3 py-2.5 transition-colors hover:bg-base-bg-alt">
                    <p class="text-sm font-medium text-base-subtle leading-snug transition-colors group-hover:text-base-heading">{p.data.title}</p>
                    <p class="mt-1 text-[11px] text-base-muted">{formatDate(p.data.date)}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

      </div>
    </aside>

  </div>

  <!-- Mobile share + author (below content) -->
  <div class="lg:hidden">
    <!-- Share -->
    <div class="mb-6 flex items-center gap-2 sm:mb-8">
      <a id="share-twitter-mobile" href="#" target="_blank" rel="noopener noreferrer"
         class="share-circle"
         aria-label="Share on X">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a id="share-linkedin-mobile" href="#" target="_blank" rel="noopener noreferrer"
         class="share-circle"
         aria-label="Share on LinkedIn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <button id="share-btn-footer-mobile" class="share-circle" aria-label="Copy link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
      </button>
    </div>

    <!-- Author card -->
    <div class="mb-6 flex items-start gap-3 rounded-2xl bg-base-bg-alt p-4 sm:mb-8 sm:gap-4 sm:p-5">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-base-accent-light font-serif font-bold text-base-heading text-lg">
        R
      </div>
      <div>
        <p class="font-semibold text-base-heading">Rifki Andriyan Pratama</p>
        <p class="mt-1 text-sm text-base-subtle leading-relaxed">Menulis tentang teknologi, pemrograman, dan pemikiran sehari-hari.</p>
      </div>
    </div>

    <!-- Tulisan lainnya (mobile) -->
    {otherPosts.length > 0 && (
      <div class="mb-8 sm:mb-10">
        <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-base-muted">Tulisan lainnya</p>
        <div class="flex flex-col divide-y divide-base-overlay">
          {otherPosts.map((p) => (
            <a href={`/blog/${p.slug}`} class="group flex items-start gap-4 py-3">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium text-base-heading leading-snug transition-colors group-hover:text-base-teal">{p.data.title}</p>
                <p class="mt-1 text-xs text-base-muted">{formatDate(p.data.date)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

</Layout>

<script is:inline>
  function initBackLink() {
    const links = document.querySelectorAll("[data-back-link]");
    if (!links.length) return;
    let href = "/blog";
    let label = "semua tulisan";
    try {
      const from = sessionStorage.getItem("tsr-post-from");
      if (from === "/") {
        href = "/";
        label = "beranda";
      }
      sessionStorage.removeItem("tsr-post-from");
    } catch {}
    links.forEach((a) => {
      a.href = href;
      const lbl = a.querySelector("[data-back-label]");
      if (lbl) lbl.textContent = label;
    });
  }

  function initPost() {
    const article = document.querySelector("main article");
    if (!article) return;

    initBackLink();

    const bar = document.getElementById("reading-bar");
    if (bar) {
      const onScroll = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          bar.style.width = `${(scrollTop / docHeight) * 100}%`;
        }
      };
      window.removeEventListener("scroll", bar._onScroll);
      window.addEventListener("scroll", onScroll, { passive: true });
      bar._onScroll = onScroll;
    }

    const pageUrl = encodeURIComponent(window.location.href);
    const pageTitle = encodeURIComponent(document.title.replace(/ — .*$/, ""));

    // Table of contents (h2/h3 dari artikel, dibangun di sisi klien)
    const toc = document.getElementById("toc");
    const tocList = document.getElementById("toc-list");
    const prose = article.querySelector(".prose");
    if (toc && tocList && prose) {
      tocList.innerHTML = "";
      const headings = [...prose.querySelectorAll("h2, h3")];
      if (headings.length >= 2) {
        const seen = {};
        headings.forEach((h) => {
          const text = h.textContent.trim();
          let id = text.normalize("NFKD").toLowerCase().trim()
            .replace(/[^\w\s-]/g, " ").replace(/\s+/g, "-").replace(/-+/g, "-") || "bagian";
          const c = seen[id] ?? 0;
          seen[id] = c + 1;
          if (c > 0) id = `${id}-${c}`;
          h.id = id;
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = `#${id}`;
          a.textContent = text;
          a.className = h.tagName === "H3"
            ? "block py-1 pl-3 text-xs leading-snug text-base-muted transition-colors hover:text-base-teal"
            : "block py-1 text-xs font-semibold leading-snug text-base-subtle transition-colors hover:text-base-teal";
          li.appendChild(a);
          tocList.appendChild(li);
        });
        toc.classList.remove("hidden");
      }
    }

    // Mode baca fokus (sepia)
    const sepia = document.getElementById("sepia-toggle");
    if (sepia) {
      sepia.onclick = () => {
        sepia.classList.toggle("bg-base-bg-alt", document.body.classList.toggle("sepia-mode"));
      };
    }

    // Desktop share buttons
    const twitter = document.getElementById("share-twitter");
    const linkedin = document.getElementById("share-linkedin");
    if (twitter) twitter.href = `https://twitter.com/intent/tweet?text=${pageTitle}&url=${pageUrl}`;
    if (linkedin) linkedin.href = `https://linkedin.com/sharing/share-offsite/?url=${pageUrl}`;

    // Mobile share buttons
    const twitterM = document.getElementById("share-twitter-mobile");
    const linkedinM = document.getElementById("share-linkedin-mobile");
    if (twitterM) twitterM.href = `https://twitter.com/intent/tweet?text=${pageTitle}&url=${pageUrl}`;
    if (linkedinM) linkedinM.href = `https://linkedin.com/sharing/share-offsite/?url=${pageUrl}`;

    // Copy link buttons (both desktop & mobile)
    ["share-btn-footer", "share-btn-footer-mobile"].forEach((id) => {
      const btn = document.getElementById(id);
      if (btn) {
        btn.onclick = async () => {
          try {
            await navigator.clipboard.writeText(decodeURIComponent(pageUrl));
            btn.style.borderColor = "var(--color-teal)";
            setTimeout(() => { btn.style.borderColor = ""; }, 2000);
          } catch {}
        };
      }
    });

    document.querySelectorAll("a[href^='#']").forEach((anchor) => {
      anchor.onclick = (e) => {
        const id = anchor.getAttribute("href")?.slice(1);
        if (!id) return;
        const target = document.getElementById(id);
        if (target) {
          e.preventDefault();
          const offset = 100;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: "smooth" });
          history.pushState(null, "", `#${id}`);
        }
      };
    });

    document.querySelectorAll(".prose img").forEach((img) => {
      if (img.closest("a")) return;
      img.style.cursor = "zoom-in";
      img.onclick = () => {
        const prevActive = document.activeElement;

        const overlay = document.createElement("div");
        overlay.className = "fixed inset-0 z-[200] flex items-center justify-center bg-black/70 backdrop-blur-sm cursor-zoom-out";
        overlay.setAttribute("role", "dialog");
        overlay.setAttribute("aria-modal", "true");
        overlay.setAttribute("aria-label", "Image preview");

        const full = document.createElement("img");
        full.src = img.src;
        full.alt = img.alt || "";
        full.className = "max-h-[90vh] max-w-[90vw] rounded-lg shadow-2xl";

        const close = document.createElement("button");
        close.className = "absolute top-4 right-4 text-white/70 hover:text-white transition-colors";
        close.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
        close.setAttribute("aria-label", "Close image");

        overlay.appendChild(full);
        overlay.appendChild(close);

        function cleanup() {
          overlay.remove();
          document.body.style.overflow = "";
          document.removeEventListener("keydown", onKeydown);
          prevActive?.focus();
        }

        overlay.addEventListener("click", (e) => {
          if (e.target === overlay || e.target === close) cleanup();
        });

        function onKeydown(e) {
          if (e.key === "Escape") cleanup();
          if (e.key === "Tab") {
            const focusable = overlay.querySelectorAll('button, [href], input, [tabindex]:not([tabindex="-1"])');
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last?.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first?.focus();
            }
          }
        }
        document.addEventListener("keydown", onKeydown);

        document.body.appendChild(overlay);
        document.body.style.overflow = "hidden";
        close.focus();
      };
    });
  }

  document.addEventListener("astro:page-load", initPost);
</script>
