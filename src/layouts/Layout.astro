---
// src/layouts/Layout.astro
import "@/styles/global.css";
import SearchModal from "@/components/SearchModal.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = "cs student by day, terminal addict by night. notes on software, systems, and projects.",
  ogImage = "/og-default.png",
  canonicalUrl,
} = Astro.props;

const siteTitle = "0xrifki";
const fullTitle = title === siteTitle ? siteTitle : `${title} — ${siteTitle}`;
const canonical = canonicalUrl ?? Astro.url.href;

const NAV = [
  { href: "/",         label: "home"     },
  { href: "/blog",     label: "blog"     },
  { href: "/projects", label: "projects" },
  { href: "/about",    label: "about"    },
];

const SOCIAL = [
  {
    href:  "https://github.com/RifkiAndriyanPratama",
    label: "GitHub",
    icon:  `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  },
  {
    href:  "https://linkedin.com/in/RifkiAndriyanPratama",
    label: "LinkedIn",
    icon:  `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    href:  "https://instagram.com/thestoriesrifkii",
    label: "Instagram",
    icon:  `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:type"        content="website" />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#83c092" />
    <link rel="alternate" type="application/rss+xml" title="0xrifki RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://giscus.app" />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" />
    <link rel="preload" href="/favicon.svg" as="image" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "0xrifki",
      "url": Astro.site?.href ?? canonical,
      "description": description,
    })} />

    <!-- View Transitions -->
    <ViewTransitions />
    <script is:inline>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll('[data-animate]').forEach(el => {
        el.style.animationPlayState = 'running';
      });
    });
    </script>

    <!-- Flash-prevent: restore theme before render -->
    <script is:inline>
    (function() {
      var theme = localStorage.getItem('theme');
      if (theme === 'light') document.documentElement.classList.remove('dark');
      else if (theme === 'dark') document.documentElement.classList.add('dark');
      else if (window.matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.classList.remove('dark');
    })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col bg-base-bg text-base-text">

    <!-- ── Skip link ─────────────────────────────────────────────────────────── -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded focus:bg-base-bg focus:px-4 focus:py-2 focus:text-base-text focus:outline-2 focus:outline-offset-2 focus:outline-base-teal">
      Skip to content
    </a>

    <!-- ── Navbar ──────────────────────────────────────────────────────────── -->
    <header id="navbar" class="fixed left-0 right-0 top-0 z-50 border-b border-base-overlay bg-base-bg/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3">

        <!-- Wordmark -->
        <a href="/" class="font-code text-base font-semibold text-base-teal tracking-tight transition-opacity hover:opacity-70" aria-label="Home">
          0xrifki
        </a>

        <!-- Desktop nav -->
        <ul class="hidden items-center gap-1 text-sm text-base-subtle sm:flex">
          {NAV.map(({ href, label }) => (
            <li>
              <a href={href} class="rounded px-3 py-1.5 transition-colors hover:bg-base-overlay hover:text-base-text" aria-current={Astro.url.pathname === href ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))}
          <!-- Search -->
          <li>
            <button
              id="search-btn"
              class="rounded p-1.5 text-base-muted transition-colors hover:bg-base-overlay hover:text-base-text"
              aria-label="Search posts"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            </button>
          </li>
          <!-- Theme toggle -->
          <li>
            <button
              id="theme-toggle"
              class="ml-2 rounded p-1.5 text-base-muted transition-colors hover:bg-base-overlay hover:text-base-text"
              aria-label="Toggle theme"
            >
              <svg id="theme-icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
              <svg id="theme-icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
            </button>
          </li>
        </ul>

        <!-- Hamburger + theme (mobile) -->
        <div class="flex items-center gap-2 sm:hidden">
          <button
            id="search-btn-mobile"
            class="rounded p-1.5 text-base-muted transition-colors hover:text-base-text"
            aria-label="Search posts"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
          </button>
          <button
            id="theme-toggle-mobile"
            class="rounded p-1.5 text-base-muted transition-colors hover:text-base-text"
            aria-label="Toggle theme"
          >
            <svg id="theme-icon-sun-mobile" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
            <svg id="theme-icon-moon-mobile" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
          </button>
          <button
            id="menu-btn"
            class="flex flex-col justify-center items-center gap-1 p-2.5 text-base-subtle hover:text-base-text transition-colors"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <span class="hamburger-bar block h-0.5 w-5 bg-current transition-all duration-300"></span>
            <span class="hamburger-bar block h-0.5 w-5 bg-current transition-all duration-300"></span>
            <span class="hamburger-bar block h-0.5 w-5 bg-current transition-all duration-300"></span>
          </button>
        </div>

      </nav>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="hidden border-t border-base-overlay bg-base-bg/95 backdrop-blur-md sm:hidden"
      >
        <ul class="mx-auto flex max-w-5xl flex-col px-6 py-4 text-sm text-base-subtle">
          {NAV.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="flex items-center gap-2 py-3.5 transition-colors hover:text-base-text border-b border-base-overlay last:border-0"
              >
                <span class="text-base-muted">→</span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <!-- ── Main ────────────────────────────────────────────────────────────── -->
    <main id="main-content" class="mx-auto w-full max-w-5xl flex-1 px-6 py-20 pt-28">
      <slot />
    </main>

    <!-- ── Footer ──────────────────────────────────────────────────────────── -->
    <footer class="border-t border-base-overlay bg-base-bg-alt">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-8">
        <span class="text-sm text-base-muted">
          &copy; {new Date().getFullYear()} 0xrifki
        </span>
        <div class="flex items-center gap-4">
          {SOCIAL.map(({ href, label, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="text-base-muted transition-colors hover:text-base-teal"
            >
              <Fragment set:html={icon} />
            </a>
          ))}
        </div>
      </div>
    </footer>

    <!-- ── Back to top ─────────────────────────────────────────────────────── -->
    <button id="back-to-top" aria-label="Back to top">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 15l-6-6-6 6"/></svg>
    </button>

    <!-- ── Search Modal ─────────────────────────────────────────────────────── -->
    <SearchModal />

    <!-- ── Keyboard shortcuts help ──────────────────────────────────────────── -->
    <div
      id="shortcuts-modal"
      class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/50 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-label="Keyboard shortcuts"
    >
      <div class="w-full max-w-sm rounded-xl border border-base-overlay bg-base-bg p-6 shadow-2xl">
        <h2 class="mb-4 text-sm font-medium text-base-text">keyboard shortcuts</h2>
        <div class="space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-base-subtle">search</span>
            <div class="flex gap-1">
              <kbd class="rounded border border-base-overlay px-2 py-0.5 text-xs text-base-muted">⌘K</kbd>
              <span class="text-base-muted">or</span>
              <kbd class="rounded border border-base-overlay px-2 py-0.5 text-xs text-base-muted">/</kbd>
            </div>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-base-subtle">toggle theme</span>
            <kbd class="rounded border border-base-overlay px-2 py-0.5 text-xs text-base-muted">t</kbd>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-base-subtle">close dialog</span>
            <kbd class="rounded border border-base-overlay px-2 py-0.5 text-xs text-base-muted">esc</kbd>
          </div>
        </div>
        <button
          id="shortcuts-close"
          class="mt-6 w-full rounded-lg border border-base-overlay py-2 text-sm text-base-muted transition-colors hover:bg-base-overlay hover:text-base-text"
        >
          got it
        </button>
      </div>
    </div>

  </body>
</html>

<script>
  // ── Focus trap ───────────────────────────────────────────────────────────
  function trapFocus(container) {
    const focusable = container.querySelectorAll(
      'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    function onTab(e) {
      if (e.key === "Tab") {
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last?.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first?.focus();
        }
      }
    }
    container.addEventListener("keydown", onTab);
    first?.focus();
    return () => container.removeEventListener("keydown", onTab);
  }

  // ── Mobile menu ───────────────────────────────────────────────────────────
  function initMenu() {
    const btn  = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;

    // Remove old listeners by cloning (simplest reset)
    const bars = btn.querySelectorAll(".hamburger-bar");

    btn.onclick = () => {
      const isOpen = menu.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(isOpen));
      if (isOpen) {
        bars[0].classList.add("translate-y-[7px]", "rotate-45");
        bars[1].classList.add("opacity-0");
        bars[2].classList.add("-translate-y-[7px]", "-rotate-45");
      } else {
        bars[0].classList.remove("translate-y-[7px]", "rotate-45");
        bars[1].classList.remove("opacity-0");
        bars[2].classList.remove("-translate-y-[7px]", "-rotate-45");
      }
    };

    menu.querySelectorAll("a").forEach((a) => {
      a.onclick = () => {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
        bars[0].classList.remove("translate-y-[7px]", "rotate-45");
        bars[1].classList.remove("opacity-0");
        bars[2].classList.remove("-translate-y-[7px]", "-rotate-45");
      };
    });
  }

  // ── Animations ────────────────────────────────────────────────────────────
  function initAnimations() {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.animationPlayState = "running";
          obs.unobserve(e.target);
        }
      }),
      { threshold: 0.05 }
    );
    document.querySelectorAll("[data-animate]").forEach((el) => {
      el.style.animationPlayState = "paused";
      obs.observe(el);
    });
  }

  // ── Theme toggle ──────────────────────────────────────────────────────────
  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateThemeIcons(isDark);
  }

  function updateThemeIcons(isDark) {
    document.querySelectorAll("[id^='theme-icon-sun']").forEach((el) => el.classList.toggle("hidden", !isDark));
    document.querySelectorAll("[id^='theme-icon-moon']").forEach((el) => el.classList.toggle("hidden", isDark));
  }

  function initTheme() {
    const toggle1 = document.getElementById("theme-toggle");
    const toggle2 = document.getElementById("theme-toggle-mobile");
    if (toggle1) toggle1.onclick = toggleTheme;
    if (toggle2) toggle2.onclick = toggleTheme;
    // Re-apply theme from localStorage (View Transitions overrides html attrs)
    const saved = localStorage.getItem("theme");
    if (saved === "light") document.documentElement.classList.remove("dark");
    else if (saved === "dark") document.documentElement.classList.add("dark");
    else if (window.matchMedia("(prefers-color-scheme: light)").matches) document.documentElement.classList.remove("dark");
    updateThemeIcons(document.documentElement.classList.contains("dark"));
  }

  // ── Navbar auto-hide ──────────────────────────────────────────────────────
  let lastScroll = 0;
  let navbarScrollHandler = null;

  function initNavbar() {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;

    if (navbarScrollHandler) window.removeEventListener("scroll", navbarScrollHandler);

    navbarScrollHandler = () => {
      const cur = window.scrollY;
      if (cur > lastScroll && cur > 80) navbar.classList.add("nav-hidden");
      else navbar.classList.remove("nav-hidden");
      lastScroll = cur;
    };
    window.addEventListener("scroll", navbarScrollHandler, { passive: true });
  }

  // ── Back to top ───────────────────────────────────────────────────────────
  let backTopScrollHandler = null;

  function initBackToTop() {
    const backBtn = document.getElementById("back-to-top");
    if (!backBtn) return;

    if (backTopScrollHandler) window.removeEventListener("scroll", backTopScrollHandler);
    backBtn.onclick = () => window.scrollTo({ top: 0, behavior: "smooth" });

    backTopScrollHandler = () => {
      backBtn.classList.toggle("visible", window.scrollY > 400);
    };
    window.addEventListener("scroll", backTopScrollHandler, { passive: true });
  }

  // ── Search ────────────────────────────────────────────────────────────────
  let fuse = null;
  let searchIndex = null;
  let searchInitialized = false;
  let prevActive = null;
  let releaseSearchTrap = null;

  async function initSearch() {
    const overlay = document.getElementById("search-overlay");
    const input   = document.getElementById("search-input");
    const results = document.getElementById("search-results");
    const empty   = document.getElementById("search-empty");
    const hint    = document.getElementById("search-hint");
    const triggers = document.querySelectorAll("#search-btn, #search-btn-mobile");

    if (!overlay || !input || !results) return;

    // Load Fuse once
    if (!fuse) {
      try {
        if (!searchIndex) {
          const res = await fetch("/search-index.json");
          searchIndex = await res.json();
        }
        const { default: Fuse } = await import("fuse.js");
        fuse = new Fuse(searchIndex, {
          keys: ["title", "description", "tags", "category"],
          threshold: 0.35,
          includeScore: true,
          minMatchCharLength: 2,
        });
      } catch { return; }
    }

    searchInitialized = true;
    let selectedIdx = -1;

    function render(query) {
      const q = query.trim();
      if (!q) {
        hint.classList.remove("hidden");
        empty.classList.add("hidden");
        results.querySelectorAll(".search-result-item").forEach((e) => e.remove());
        return;
      }

      hint.classList.add("hidden");
      const matches = fuse.search(q).slice(0, 12);
      results.querySelectorAll(".search-result-item").forEach((e) => e.remove());

      if (!matches.length) {
        empty.classList.remove("hidden");
        return;
      }
      empty.classList.add("hidden");

      selectedIdx = -1;
      matches.forEach(({ item }, i) => {
        const a = document.createElement("a");
        a.href = `/blog/${item.slug}/`;
        a.className = "search-result-item flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-base-overlay";
        a.dataset.index = i;
        a.innerHTML = `
          <div class="flex-1 min-w-0">
            <div class="font-medium text-sm text-base-text truncate">${highlight(item.title, q)}</div>
            <div class="text-xs text-base-muted mt-0.5">
              ${item.dateHuman || item.date} · ${item.category} · ${item.tags?.slice(0, 2).map(t => "#" + t).join(" ") || ""}
            </div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-base-muted"><path d="M9 18l6-6-6-6"/></svg>
        `;
        results.appendChild(a);

        a.addEventListener("click", (e) => {
          e.preventDefault();
          closeSearch();
          window.location.href = a.href;
        });
      });
    }

    function highlight(text, query) {
      const re = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi");
      return text.replace(re, '<mark class="search-highlight">$1</mark>');
    }

    function openSearch() {
      prevActive = document.activeElement;
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
      selectedIdx = -1;
      releaseSearchTrap = trapFocus(overlay);
      setTimeout(() => input.focus(), 100);
    }

    function closeSearch() {
      if (releaseSearchTrap) releaseSearchTrap();
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      input.value = "";
      render("");
      document.body.style.overflow = "";
      prevActive?.focus();
    }

    // Re-attach trigger listeners
    triggers.forEach((t) => {
      t.onclick = openSearch;
    });

    input.oninput = () => render(input.value);
    input.onkeydown = null; // remove old before adding new

    input.addEventListener("keydown", (e) => {
      const items = results.querySelectorAll(".search-result-item");
      if (e.key === "ArrowDown") {
        e.preventDefault();
        selectedIdx = Math.min(selectedIdx + 1, items.length - 1);
        items.forEach((el, i) => el.classList.toggle("bg-base-overlay", i === selectedIdx));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        selectedIdx = Math.max(selectedIdx - 1, -1);
        items.forEach((el, i) => el.classList.toggle("bg-base-overlay", i === selectedIdx));
      } else if (e.key === "Enter" && selectedIdx >= 0 && items[selectedIdx]) {
        e.preventDefault();
        const href = items[selectedIdx].getAttribute("href");
        if (href) { closeSearch(); window.location.href = href; }
      }
    });

    overlay.onclick = (e) => {
      if (e.target === overlay) closeSearch();
    };
  }

  // ── Shortcuts modal ──────────────────────────────────────────────────────
  let releaseShortcutsTrap = null;

  function openShortcuts() {
    const modal = document.getElementById("shortcuts-modal");
    if (!modal) return;
    prevActive = document.activeElement;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    releaseShortcutsTrap = trapFocus(modal);
  }

  function closeShortcuts() {
    const modal = document.getElementById("shortcuts-modal");
    if (!modal) return;
    if (releaseShortcutsTrap) releaseShortcutsTrap();
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    prevActive?.focus();
  }

  function initShortcuts() {
    const closeBtn = document.getElementById("shortcuts-close");
    const modal = document.getElementById("shortcuts-modal");
    if (closeBtn) closeBtn.onclick = closeShortcuts;
    if (modal) modal.onclick = (e) => { if (e.target === e.currentTarget) closeShortcuts(); };
  }

  // ── Init all ─────────────────────────────────────────────────────────────
  function initAll() {
    initMenu();
    initAnimations();
    initTheme();
    initNavbar();
    initBackToTop();
    initSearch();
    initShortcuts();
  }

  // Run on first load & every View Transition
  document.addEventListener("DOMContentLoaded", initAll);
  document.addEventListener("astro:page-load", initAll);

  // ── Global keyboard shortcuts ────────────────────────────────────────────
  document.addEventListener("keydown", (e) => {
    const shortcutsModal = document.getElementById("shortcuts-modal");
    const searchOverlay  = document.getElementById("search-overlay");

    if (e.key === "?" && !e.ctrlKey && !e.metaKey && !e.altKey) {
      const active = document.activeElement?.tagName;
      if (active === "INPUT" || active === "TEXTAREA") return;
      e.preventDefault();
      if (shortcutsModal?.classList.contains("hidden")) {
        openShortcuts();
      } else {
        closeShortcuts();
      }
    }

    if (e.key === "t" && !e.ctrlKey && !e.metaKey && !e.altKey) {
      const active = document.activeElement?.tagName;
      if (active === "INPUT" || active === "TEXTAREA") return;
      e.preventDefault();
      toggleTheme();
    }

    if (e.key === "Escape") {
      if (shortcutsModal && !shortcutsModal.classList.contains("hidden")) {
        closeShortcuts();
      }
      if (searchOverlay && !searchOverlay.classList.contains("hidden")) {
        searchOverlay.classList.add("hidden");
        searchOverlay.classList.remove("flex");
        document.body.style.overflow = "";
        if (releaseSearchTrap) releaseSearchTrap();
        prevActive?.focus();
      }
    }

    if (e.key === "s" && !e.ctrlKey && !e.metaKey) {
      const active = document.activeElement?.tagName;
      if (active === "INPUT" || active === "TEXTAREA") return;
      e.preventDefault();
      const btn = document.querySelector("#search-btn, #search-btn-mobile");
      if (btn && searchOverlay?.classList.contains("hidden")) btn.click();
    }

    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      if (searchOverlay?.classList.contains("hidden")) {
        document.querySelector("#search-btn, #search-btn-mobile")?.click();
      } else {
        searchOverlay.classList.add("hidden");
        searchOverlay.classList.remove("flex");
        document.body.style.overflow = "";
      }
    }
  });
</script>
