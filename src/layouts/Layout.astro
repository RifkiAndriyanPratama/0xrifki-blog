---
// src/layouts/Layout.astro
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import BottomNav from "@/components/BottomNav.astro";
import SearchModal from "@/components/SearchModal.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  lang?: string;
  immersive?: boolean;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description = "cerita seputar coding, teknologi, dan kehidupan. ditulis dengan bahasa yang gampang dipahami.",
  ogImage = "/og-default.png",
  canonicalUrl,
  lang = "id",
  immersive = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;

const siteTitle = "thestoriesrifki";
const fullTitle = title === siteTitle ? siteTitle : `${title} — ${siteTitle}`;
const canonical = canonicalUrl ?? Astro.url.href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:type"        content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#b4533a" />
    <link rel="alternate" type="application/rss+xml" title="thestoriesrifki RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Literata:ital,opsz,wght@0,7..72,400..700;1,7..72,400..600&family=Dancing+Script:wght@500;600&display=swap" />
    <link rel="preload" href="/favicon.svg" as="image" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "thestoriesrifki",
      "url": Astro.site?.href ?? canonical,
      "description": description,
    })} />

    <ViewTransitions />
    <script is:inline>
    document.addEventListener('astro:page-load', () => {
      document.documentElement.style.colorScheme = 'light';
      document.querySelectorAll('[data-animate]').forEach(el => {
        el.style.animationPlayState = 'running';
      });
    });
    </script>
  </head>

  <body class="flex min-h-screen flex-col bg-base-bg text-base-text">

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded focus:bg-base-bg focus:px-4 focus:py-2 focus:text-base-text focus:outline-2 focus:outline-offset-2 focus:outline-base-teal">
      Loncat ke konten
    </a>

    <Header />

    <main id="main-content" class="mx-auto w-full max-w-[1240px] flex-1 px-4 pb-24 sm:px-6 md:px-8 md:pb-0">
      <slot />
    </main>

    <footer class="mt-8 border-t border-base-overlay sm:mt-20">
        <div class="mx-auto max-w-[1240px] px-4 pt-6 pb-32 sm:px-6 sm:pt-10 sm:pb-32 md:px-8 md:pb-10">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
          <div>
            <a href="/" class="font-serif text-base font-bold tracking-tight text-base-heading sm:text-lg">
              thestoriesrifki<span class="text-base-teal">.</span>
            </a>
            <p class="mt-1 font-signature text-xl leading-none text-base-subtle">Rifki Andriyan</p>
          </div>
          <div class="flex items-center gap-3 text-sm text-base-muted sm:gap-4">
            <a href="/rss.xml" class="transition-colors hover:text-base-heading">RSS</a>
            <a href="/colophon" class="transition-colors hover:text-base-heading">Colophon</a>
            <a href="https://instagram.com/thestoriesrifkii" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-base-heading">Instagram</a>
            <a href="https://github.com/RifkiAndriyanPratama" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-base-heading">GitHub</a>
          </div>
        </div>
        <p class="mt-4 font-code text-xs text-base-muted sm:mt-6">
          &copy; thestoriesrifki {new Date().getFullYear()}
        </p>
      </div>
    </footer>

    <button id="back-to-top" aria-label="Kembali ke atas">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>

    <BottomNav />

    <SearchModal />

  </body>
</html>

<script>
  function trapFocus(container) {
    const focusable = container.querySelectorAll(
      'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    function onTab(e) {
      if (e.key === "Tab") {
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last?.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first?.focus();
        }
      }
    }
    container.addEventListener("keydown", onTab);
    first?.focus();
    return () => container.removeEventListener("keydown", onTab);
  }

  function initAnimations() {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.animationPlayState = "running";
          obs.unobserve(e.target);
        }
      }),
      { threshold: 0.05 }
    );
    document.querySelectorAll("[data-animate]").forEach((el) => {
      el.style.animationPlayState = "paused";
      obs.observe(el);
    });
  }

  let backTopScrollHandler = null;

  function initBackToTop() {
    const backBtn = document.getElementById("back-to-top");
    if (!backBtn) return;

    if (backTopScrollHandler) window.removeEventListener("scroll", backTopScrollHandler);
    backBtn.onclick = () => window.scrollTo({ top: 0, behavior: "smooth" });

    backTopScrollHandler = () => {
      backBtn.classList.toggle("visible", window.scrollY > 400);
    };
    window.addEventListener("scroll", backTopScrollHandler, { passive: true });
  }

  let fuse = null;
  let searchIndex = null;
  let searchInitialized = false;
  let prevActive = null;
  let releaseSearchTrap = null;

  async function initSearch() {
    const overlay = document.getElementById("search-overlay");
    const input   = document.getElementById("search-input");
    const results = document.getElementById("search-results");
    const empty   = document.getElementById("search-empty");
    const hint    = document.getElementById("search-hint");
    const triggers = document.querySelectorAll("#search-btn");

    if (!overlay || !input || !results) return;

    if (!fuse) {
      try {
        if (!searchIndex) {
          const res = await fetch("/search-index.json");
          searchIndex = await res.json();
        }
        const { default: Fuse } = await import("fuse.js");
        fuse = new Fuse(searchIndex, {
          keys: ["title", "description", "tags", "category"],
          threshold: 0.35,
          includeScore: true,
          minMatchCharLength: 2,
        });
      } catch { return; }
    }

    searchInitialized = true;
    let selectedIdx = -1;

    function render(query) {
      const q = query.trim();
      if (!q) {
        hint.classList.remove("hidden");
        empty.classList.add("hidden");
        results.querySelectorAll(".search-result-item").forEach((e) => e.remove());
        return;
      }

      hint.classList.add("hidden");
      const matches = fuse.search(q).slice(0, 12);
      results.querySelectorAll(".search-result-item").forEach((e) => e.remove());

      if (!matches.length) {
        empty.classList.remove("hidden");
        return;
      }
      empty.classList.add("hidden");

      selectedIdx = -1;
      matches.forEach(({ item }, i) => {
        const a = document.createElement("a");
        a.href = `/blog/${item.slug}/`;
        a.className = "search-result-item flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-base-bg-alt";
        a.dataset.index = i;
        a.innerHTML = `
          <div class="flex-1 min-w-0">
            <div class="font-medium text-sm text-base-text truncate">${highlight(item.title, q)}</div>
            <div class="text-xs text-base-muted mt-0.5">
              ${item.dateHuman || item.date} · ${item.category} · ${item.tags?.slice(0, 2).map(t => "#" + t).join(" ") || ""}
            </div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-base-muted"><path d="M9 18l6-6-6-6"/></svg>
        `;
        results.appendChild(a);

        a.addEventListener("click", (e) => {
          e.preventDefault();
          closeSearch();
          window.location.href = a.href;
        });
      });
    }

    function highlight(text, query) {
      const re = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi");
      return text.replace(re, '<mark class="search-highlight">$1</mark>');
    }

    function openSearch() {
      prevActive = document.activeElement;
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
      selectedIdx = -1;
      releaseSearchTrap = trapFocus(overlay);
      setTimeout(() => input.focus(), 100);
    }

    function closeSearch() {
      if (releaseSearchTrap) releaseSearchTrap();
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      input.value = "";
      render("");
      document.body.style.overflow = "";
      prevActive?.focus();
    }

    triggers.forEach((t) => {
      t.onclick = openSearch;
    });

    input.oninput = () => render(input.value);
    input.onkeydown = null;

    input.addEventListener("keydown", (e) => {
      const items = results.querySelectorAll(".search-result-item");
      if (e.key === "ArrowDown") {
        e.preventDefault();
        selectedIdx = Math.min(selectedIdx + 1, items.length - 1);
        items.forEach((el, i) => el.classList.toggle("bg-base-bg-alt", i === selectedIdx));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        selectedIdx = Math.max(selectedIdx - 1, -1);
        items.forEach((el, i) => el.classList.toggle("bg-base-bg-alt", i === selectedIdx));
      } else if (e.key === "Enter" && selectedIdx >= 0 && items[selectedIdx]) {
        e.preventDefault();
        const href = items[selectedIdx].getAttribute("href");
        if (href) { closeSearch(); window.location.href = href; }
      }
    });

    overlay.onclick = (e) => {
      if (e.target === overlay) closeSearch();
    };
  }

  function initAll() {
    initAnimations();
    initBackToTop();
    initSearch();
  }

  document.addEventListener("DOMContentLoaded", initAll);
  document.addEventListener("astro:page-load", initAll);

  // Rekam halaman asal saat user mengeklik tautan ke sebuah post,
  // supaya tombol "kembali" di halaman post bisa kontekstual (beranda vs semua tulisan).
  document.addEventListener("click", (e) => {
    const a = e.target.closest("a[href^='/blog/']");
    if (!a || !a.closest("#main-content")) return;
    const from = window.location.pathname;
    if (from === "/" || from === "/blog/") {
      try { sessionStorage.setItem("tsr-post-from", from); } catch {}
    }
  }, true);

  document.addEventListener("keydown", (e) => {
    const searchOverlay  = document.getElementById("search-overlay");

    if (e.key === "Escape") {
      if (searchOverlay && !searchOverlay.classList.contains("hidden")) {
        searchOverlay.classList.add("hidden");
        searchOverlay.classList.remove("flex");
        document.body.style.overflow = "";
        if (releaseSearchTrap) releaseSearchTrap();
        prevActive?.focus();
      }
    }

    if (e.key === "s" && !e.ctrlKey && !e.metaKey) {
      const active = document.activeElement?.tagName;
      if (active === "INPUT" || active === "TEXTAREA") return;
      e.preventDefault();
      const btn = document.querySelector("#search-btn");
      if (btn && searchOverlay?.classList.contains("hidden")) btn.click();
    }

    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      if (searchOverlay?.classList.contains("hidden")) {
        document.querySelector("#search-btn")?.click();
      } else {
        searchOverlay.classList.add("hidden");
        searchOverlay.classList.remove("flex");
        document.body.style.overflow = "";
      }
    }
  });
</script>
