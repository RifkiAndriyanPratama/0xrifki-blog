---
// src/layouts/Layout.astro
import "@/styles/global.css";
import SearchModal from "@/components/SearchModal.astro";
import { ViewTransitions } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  lang?: string;
  immersive?: boolean;
  ogType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
}

const {
  title,
  description = "notes on software, systems, and whatever ends up in the terminal at 2am.",
  ogImage = "/og-default.png",
  canonicalUrl,
  lang = "en",
  immersive = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;

const siteTitle = "0xrifki";
const fullTitle = title === siteTitle ? siteTitle : `${title} — ${siteTitle}`;
const canonical = canonicalUrl ?? Astro.url.href;

const NAV = [
  { href: "/",         label: "Home"    },
  { href: "/blog",     label: "Blog"    },
  { href: "/projects", label: "Projects" },
  { href: "/about",    label: "About"   },
];

const FOOTER_NAV = [
  {
    heading: "Explore",
    links: [
      { href: "/blog",     label: "Blog"     },
      { href: "/projects", label: "Projects" },
      { href: "/about",    label: "About"    },
      { href: "/blog/tags", label: "Tags"    },
    ],
  },
  {
    heading: "Connect",
    links: [
      { href: "https://github.com/RifkiAndriyanPratama", label: "GitHub" },
      { href: "https://linkedin.com/in/RifkiAndriyanPratama", label: "LinkedIn" },
      { href: "https://instagram.com/thestoriesrifkii", label: "Instagram" },
      { href: "/rss.xml", label: "RSS Feed" },
    ],
  },
  {
    heading: "More",
    links: [
      { href: "/blog/category/devops", label: "DevOps" },
      { href: "/blog/category/systems", label: "Systems" },
      { href: "/blog/category/programming", label: "Programming" },
      { href: "/blog/tags", label: "All Tags" },
    ],
  },
];

const SOCIAL = [
  {
    href:  "https://github.com/RifkiAndriyanPratama",
    label: "GitHub",
    icon:  `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>`,
  },
  {
    href:  "https://linkedin.com/in/RifkiAndriyanPratama",
    label: "LinkedIn",
    icon:  `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    href:  "https://instagram.com/thestoriesrifkii",
    label: "Instagram",
    icon:  `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
  },
];
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:type"        content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#5fedac" />
    <link rel="alternate" type="application/rss+xml" title="0xrifki RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" />
    <link rel="preload" href="/favicon.svg" as="image" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "0xrifki",
      "url": Astro.site?.href ?? canonical,
      "description": description,
    })} />

    <!-- View Transitions -->
    <ViewTransitions />
    <script is:inline>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll('[data-animate]').forEach(el => {
        el.style.animationPlayState = 'running';
      });
    });
    </script>

    <!-- Flash-prevent: restore theme before render -->
    <script is:inline>
    (function() {
      var theme = localStorage.getItem('theme');
      if (theme === 'light') document.documentElement.classList.remove('dark');
      else if (theme === 'dark') document.documentElement.classList.add('dark');
      else if (window.matchMedia('(prefers-color-scheme: light)').matches) document.documentElement.classList.remove('dark');
    })();
    </script>
  </head>

  <body class={`flex min-h-screen flex-col bg-base-bg text-base-text${immersive ? " has-immersive-nav" : ""}`}>

    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[300] focus:rounded focus:bg-base-bg focus:px-4 focus:py-2 focus:text-base-text focus:outline-2 focus:outline-offset-2 focus:outline-base-teal">
      Skip to content
    </a>

    <header id="navbar" class="sticky top-0 z-50 w-full">
      <div class="mx-auto flex max-w-[1392px] items-center justify-between gap-4 px-4 py-3 sm:px-6">

        <!-- Wordmark -->
        <a href="/" class="flex items-center text-xl font-bold tracking-tight text-base-heading" aria-label="Home">
          <span class="text-gradient">0x</span>rifki
        </a>

        <!-- Desktop nav -->
        <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary">
          {NAV.map(({ href, label }) => (
            <a
              href={href}
              class="nav-link"
              aria-current={Astro.url.pathname === href ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-1">
          <!-- Search -->
          <button
            id="search-btn"
            class="nav-icon"
            aria-label="Search posts"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.031 16.6168L22.3137 20.8995L20.8995 22.3137L16.6168 18.031C15.0769 19.263 13.124 20 11 20C6.032 20 2 15.968 2 11C2 6.032 6.032 2 11 2C15.968 2 20 6.032 20 11C20 13.124 19.263 15.0769 18.031 16.6168ZM16.0247 15.8748C17.2475 14.6146 18 12.8956 18 11C18 7.1325 14.8675 4 11 4C7.1325 4 4 7.1325 4 11C4 14.8675 7.1325 18 11 18C12.8956 18 14.6146 17.2475 15.8748 16.0247Z"/></svg>
          </button>
          <!-- Theme toggle -->
          <button
            id="theme-toggle"
            class="nav-icon"
            aria-label="Toggle theme"
          >
            <svg id="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="hidden"><path d="M12 18C8.68629 18 6 15.3137 6 12C6 8.68629 8.68629 6 12 6C15.3137 6 18 8.68629 18 12C18 15.3137 15.3137 18 12 18ZM12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16ZM11 1H13V4H11V1ZM11 20H13V23H11V20ZM3.51472 4.92893L4.92893 3.51472L7.05025 5.63604L5.63604 7.05025L3.51472 4.92893ZM16.9497 18.364L18.364 16.9497L20.4853 19.0711L19.0711 20.4853L16.9497 18.364ZM19.0711 3.51472L20.4853 4.92893L18.364 7.05025L16.9497 5.63604L19.0711 3.51472ZM5.63604 16.9497L7.05025 18.364L4.92893 20.4853L3.51472 19.0711L5.63604 16.9497ZM23 11V13H20V11H23ZM4 11V13H1V11H4Z"/></svg>
            <svg id="theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M10 7C10 10.866 13.134 14 17 14C18.9584 14 20.729 13.1957 21.9995 11.8995C22 11.933 22 11.9665 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C12.0335 2 12.067 2 12.1005 2.00049C10.8043 3.27098 10 5.04157 10 7ZM4 12C4 16.4183 7.58172 20 12 20C15.0583 20 17.7158 18.2839 19.062 15.7621C18.3945 15.9187 17.7035 16 17 16C12.0294 16 8 11.9706 8 7C8 6.29648 8.08133 5.60547 8.2379 4.938C5.71611 6.28423 4 8.9417 4 12Z"/></svg>
          </button>

          <!-- GitHub CTA -->
          <a
            href="https://github.com/RifkiAndriyanPratama"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-sm ml-2 hidden sm:inline-flex"
          >
            GitHub
          </a>

          <!-- Hamburger (mobile) -->
          <button
            id="menu-btn"
            class="nav-icon lg:hidden"
            aria-label="Toggle menu"
            aria-expanded="false"
          >
            <svg id="menu-burger" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            <svg id="menu-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="hidden border-t border-base-overlay lg:hidden"
      >
        <ul class="mx-auto flex max-w-[1392px] flex-col px-4 pb-4 sm:px-6">
          {NAV.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={Astro.url.pathname === href ? "page" : undefined}
                class="flex items-center gap-2 py-3.5 text-base-subtle transition-colors hover:text-base-heading"
              >
                {label}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a
              href="https://github.com/RifkiAndriyanPratama"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-block btn-sm"
            >
              GitHub
            </a>
          </li>
        </ul>
      </div>
    </header>

    <main id="main-content" class="mx-auto w-full max-w-[1392px] flex-1 px-4 sm:px-6">
      <slot />
    </main>

    <footer class="mt-20 border-t border-base-overlay bg-base-bg">
      <div class="mx-auto max-w-[1392px] px-4 py-16 sm:px-6">
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
          <!-- Brand -->
          <div>
            <a href="/" class="flex items-center text-2xl font-bold tracking-tight text-base-heading">
              <span class="text-gradient">0x</span>rifki
            </a>
            <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-base-subtle">
              cs student by day, terminal addict by night. notes on software, systems,
              and whatever ends up in the terminal at 2am.
            </p>
            <div class="mt-6 flex items-center gap-3">
              {SOCIAL.map(({ href, label, icon }) => (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={label}
                  class="social-icon"
                >
                  <Fragment set:html={icon} />
                </a>
              ))}
            </div>
          </div>

          <!-- Nav columns -->
          <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
            {FOOTER_NAV.map(({ heading, links }) => (
              <div>
                <p class="footer-nav-heading">{heading}</p>
                <ul class="space-y-3">
                  {links.map(({ href, label }) => (
                    <li>
                      <a href={href} class="footer-nav-link">{label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="border-t border-base-overlay">
        <div class="mx-auto flex max-w-[1392px] flex-wrap items-center justify-between gap-3 px-4 py-6 sm:px-6">
          <span class="font-code text-xs text-base-muted">
            &copy; 0xrifki {new Date().getFullYear()} · v0x0.1.0-0x0001
          </span>
          <span class="font-code text-xs text-base-muted">
            compiled with astro · exit 0
          </span>
        </div>
      </div>
    </footer>

    <button id="back-to-top" class="font-code" aria-label="Back to top">
      Back to top
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
    </button>

    <SearchModal />

    <div
      id="shortcuts-modal"
      class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/50 backdrop-blur-sm"
      role="dialog"
      aria-modal="true"
      aria-label="Keyboard shortcuts"
    >
      <div class="w-full max-w-sm rounded-2xl border border-base-overlay bg-base-bg p-6 shadow-2xl">
        <h2 class="mb-4 text-sm font-semibold text-base-heading">keyboard shortcuts</h2>
        <div class="space-y-3 text-sm">
          <div class="flex items-center justify-between">
            <span class="text-base-subtle">search</span>
            <div class="flex gap-1">
              <kbd class="rounded border border-base-overlay px-2 py-0.5 text-xs text-base-muted">⌘K</kbd>
              <span class="text-base-muted">or</span>
              <kbd class="rounded border border-base-overlay px-2 py-0.5 text-xs text-base-muted">/</kbd>
            </div>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-base-subtle">toggle theme</span>
            <kbd class="rounded border border-base-overlay px-2 py-0.5 text-xs text-base-muted">t</kbd>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-base-subtle">close dialog</span>
            <kbd class="rounded border border-base-overlay px-2 py-0.5 text-xs text-base-muted">esc</kbd>
          </div>
        </div>
        <button
          id="shortcuts-close"
          class="btn btn-block mt-6"
        >
          got it
        </button>
      </div>
    </div>

  </body>
</html>

<script>
  function trapFocus(container) {
    const focusable = container.querySelectorAll(
      'a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])'
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    function onTab(e) {
      if (e.key === "Tab") {
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last?.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first?.focus();
        }
      }
    }
    container.addEventListener("keydown", onTab);
    first?.focus();
    return () => container.removeEventListener("keydown", onTab);
  }

  function initMenu() {
    const btn  = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    const burger = document.getElementById("menu-burger");
    const close = document.getElementById("menu-close");
    if (!btn || !menu) return;

    btn.onclick = () => {
      const isOpen = menu.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", String(isOpen));
      burger?.classList.toggle("hidden", isOpen);
      close?.classList.toggle("hidden", !isOpen);
    };

    menu.querySelectorAll("a").forEach((a) => {
      a.onclick = () => {
        menu.classList.add("hidden");
        btn.setAttribute("aria-expanded", "false");
        burger?.classList.remove("hidden");
        close?.classList.add("hidden");
      };
    });
  }

  function initAnimations() {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.animationPlayState = "running";
          obs.unobserve(e.target);
        }
      }),
      { threshold: 0.05 }
    );
    document.querySelectorAll("[data-animate]").forEach((el) => {
      el.style.animationPlayState = "paused";
      obs.observe(el);
    });
  }

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateThemeIcons(isDark);
  }

  function updateThemeIcons(isDark) {
    document.querySelectorAll("[id^='theme-icon-sun']").forEach((el) => el.classList.toggle("hidden", !isDark));
    document.querySelectorAll("[id^='theme-icon-moon']").forEach((el) => el.classList.toggle("hidden", isDark));
  }

  function initTheme() {
    const toggle1 = document.getElementById("theme-toggle");
    if (toggle1) toggle1.onclick = toggleTheme;
    const saved = localStorage.getItem("theme");
    if (saved === "light") document.documentElement.classList.remove("dark");
    else if (saved === "dark") document.documentElement.classList.add("dark");
    else if (window.matchMedia("(prefers-color-scheme: light)").matches) document.documentElement.classList.remove("dark");
    updateThemeIcons(document.documentElement.classList.contains("dark"));
  }

  let navbarScrollHandler = null;

  function initNavbar() {
    const navbar = document.getElementById("navbar");
    if (!navbar) return;

    if (navbarScrollHandler) window.removeEventListener("scroll", navbarScrollHandler);

    let lastY = window.scrollY;
    navbarScrollHandler = () => {
      const y = window.scrollY;
      navbar.classList.toggle("scrolled", y > 8);

      // immersive auto-hide — only on post pages (body.has-immersive-nav)
      if (document.body.classList.contains("has-immersive-nav")) {
        const hide = y > 160 && y > lastY;
        navbar.classList.toggle("nav-hidden", hide);
        lastY = y;
      }
    };
    window.addEventListener("scroll", navbarScrollHandler, { passive: true });
    navbarScrollHandler();
  }

  let backTopScrollHandler = null;

  function initBackToTop() {
    const backBtn = document.getElementById("back-to-top");
    if (!backBtn) return;

    if (backTopScrollHandler) window.removeEventListener("scroll", backTopScrollHandler);
    backBtn.onclick = () => window.scrollTo({ top: 0, behavior: "smooth" });

    backTopScrollHandler = () => {
      backBtn.classList.toggle("visible", window.scrollY > 400);
    };
    window.addEventListener("scroll", backTopScrollHandler, { passive: true });
  }

  let fuse = null;
  let searchIndex = null;
  let searchInitialized = false;
  let prevActive = null;
  let releaseSearchTrap = null;

  async function initSearch() {
    const overlay = document.getElementById("search-overlay");
    const input   = document.getElementById("search-input");
    const results = document.getElementById("search-results");
    const empty   = document.getElementById("search-empty");
    const hint    = document.getElementById("search-hint");
    const triggers = document.querySelectorAll("#search-btn");

    if (!overlay || !input || !results) return;

    // Load Fuse once
    if (!fuse) {
      try {
        if (!searchIndex) {
          const res = await fetch("/search-index.json");
          searchIndex = await res.json();
        }
        const { default: Fuse } = await import("fuse.js");
        fuse = new Fuse(searchIndex, {
          keys: ["title", "description", "tags", "category"],
          threshold: 0.35,
          includeScore: true,
          minMatchCharLength: 2,
        });
      } catch { return; }
    }

    searchInitialized = true;
    let selectedIdx = -1;

    function render(query) {
      const q = query.trim();
      if (!q) {
        hint.classList.remove("hidden");
        empty.classList.add("hidden");
        results.querySelectorAll(".search-result-item").forEach((e) => e.remove());
        return;
      }

      hint.classList.add("hidden");
      const matches = fuse.search(q).slice(0, 12);
      results.querySelectorAll(".search-result-item").forEach((e) => e.remove());

      if (!matches.length) {
        empty.classList.remove("hidden");
        return;
      }
      empty.classList.add("hidden");

      selectedIdx = -1;
      matches.forEach(({ item }, i) => {
        const a = document.createElement("a");
        a.href = `/blog/${item.slug}/`;
        a.className = "search-result-item flex items-center gap-3 rounded-lg px-3 py-2.5 transition-colors hover:bg-base-bg-alt";
        a.dataset.index = i;
        a.innerHTML = `
          <div class="flex-1 min-w-0">
            <div class="font-medium text-sm text-base-text truncate">${highlight(item.title, q)}</div>
            <div class="text-xs text-base-muted mt-0.5">
              ${item.dateHuman || item.date} · ${item.category} · ${item.tags?.slice(0, 2).map(t => "#" + t).join(" ") || ""}
            </div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 text-base-muted"><path d="M9 18l6-6-6-6"/></svg>
        `;
        results.appendChild(a);

        a.addEventListener("click", (e) => {
          e.preventDefault();
          closeSearch();
          window.location.href = a.href;
        });
      });
    }

    function highlight(text, query) {
      const re = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`, "gi");
      return text.replace(re, '<mark class="search-highlight">$1</mark>');
    }

    function openSearch() {
      prevActive = document.activeElement;
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      document.body.style.overflow = "hidden";
      selectedIdx = -1;
      releaseSearchTrap = trapFocus(overlay);
      setTimeout(() => input.focus(), 100);
    }

    function closeSearch() {
      if (releaseSearchTrap) releaseSearchTrap();
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      input.value = "";
      render("");
      document.body.style.overflow = "";
      prevActive?.focus();
    }

    // Re-attach trigger listeners
    triggers.forEach((t) => {
      t.onclick = openSearch;
    });

    input.oninput = () => render(input.value);
    input.onkeydown = null; // remove old before adding new

    input.addEventListener("keydown", (e) => {
      const items = results.querySelectorAll(".search-result-item");
      if (e.key === "ArrowDown") {
        e.preventDefault();
        selectedIdx = Math.min(selectedIdx + 1, items.length - 1);
        items.forEach((el, i) => el.classList.toggle("bg-base-bg-alt", i === selectedIdx));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        selectedIdx = Math.max(selectedIdx - 1, -1);
        items.forEach((el, i) => el.classList.toggle("bg-base-bg-alt", i === selectedIdx));
      } else if (e.key === "Enter" && selectedIdx >= 0 && items[selectedIdx]) {
        e.preventDefault();
        const href = items[selectedIdx].getAttribute("href");
        if (href) { closeSearch(); window.location.href = href; }
      }
    });

    overlay.onclick = (e) => {
      if (e.target === overlay) closeSearch();
    };
  }

  let releaseShortcutsTrap = null;

  function openShortcuts() {
    const modal = document.getElementById("shortcuts-modal");
    if (!modal) return;
    prevActive = document.activeElement;
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    releaseShortcutsTrap = trapFocus(modal);
  }

  function closeShortcuts() {
    const modal = document.getElementById("shortcuts-modal");
    if (!modal) return;
    if (releaseShortcutsTrap) releaseShortcutsTrap();
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    prevActive?.focus();
  }

  function initShortcuts() {
    const closeBtn = document.getElementById("shortcuts-close");
    const modal = document.getElementById("shortcuts-modal");
    if (closeBtn) closeBtn.onclick = closeShortcuts;
    if (modal) modal.onclick = (e) => { if (e.target === e.currentTarget) closeShortcuts(); };
  }

  let cardGlowBound = false;
  function initCardGlow() {
    if (cardGlowBound) return;
    cardGlowBound = true;
    document.addEventListener("mousemove", (e) => {
      const card = e.target?.closest?.(".js-card");
      if (!card) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${((e.clientX - r.left) / r.width) * 100}%`);
      card.style.setProperty("--my", `${((e.clientY - r.top) / r.height) * 100}%`);
    }, { passive: true });
  }

  function initAll() {
    initMenu();
    initAnimations();
    initTheme();
    initNavbar();
    initBackToTop();
    initSearch();
    initShortcuts();
    initCardGlow();
  }

  // Run on first load & every View Transition
  document.addEventListener("DOMContentLoaded", initAll);
  document.addEventListener("astro:page-load", initAll);

  document.addEventListener("keydown", (e) => {
    const shortcutsModal = document.getElementById("shortcuts-modal");
    const searchOverlay  = document.getElementById("search-overlay");

    if (e.key === "?" && !e.ctrlKey && !e.metaKey && !e.altKey) {
      const active = document.activeElement?.tagName;
      if (active === "INPUT" || active === "TEXTAREA") return;
      e.preventDefault();
      if (shortcutsModal?.classList.contains("hidden")) {
        openShortcuts();
      } else {
        closeShortcuts();
      }
    }

    if (e.key === "t" && !e.ctrlKey && !e.metaKey && !e.altKey) {
      const active = document.activeElement?.tagName;
      if (active === "INPUT" || active === "TEXTAREA") return;
      e.preventDefault();
      toggleTheme();
    }

    if (e.key === "Escape") {
      if (shortcutsModal && !shortcutsModal.classList.contains("hidden")) {
        closeShortcuts();
      }
      if (searchOverlay && !searchOverlay.classList.contains("hidden")) {
        searchOverlay.classList.add("hidden");
        searchOverlay.classList.remove("flex");
        document.body.style.overflow = "";
        if (releaseSearchTrap) releaseSearchTrap();
        prevActive?.focus();
      }
    }

    if (e.key === "s" && !e.ctrlKey && !e.metaKey) {
      const active = document.activeElement?.tagName;
      if (active === "INPUT" || active === "TEXTAREA") return;
      e.preventDefault();
      const btn = document.querySelector("#search-btn");
      if (btn && searchOverlay?.classList.contains("hidden")) btn.click();
    }

    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      if (searchOverlay?.classList.contains("hidden")) {
        document.querySelector("#search-btn")?.click();
      } else {
        searchOverlay.classList.add("hidden");
        searchOverlay.classList.remove("flex");
        document.body.style.overflow = "";
      }
    }
  });
</script>