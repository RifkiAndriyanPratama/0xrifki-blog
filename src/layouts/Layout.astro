---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:type"        content="website" />
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body class="flex min-h-screen flex-col bg-base-bg text-base-text">

    <!-- ── Navbar ──────────────────────────────────────────────────────────── -->
    <header class="sticky top-0 z-50 border-b border-base-overlay bg-base-bg/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">

        <!-- Wordmark -->
        <a href="/" class="font-code text-base font-semibold text-base-teal tracking-tight transition-opacity hover:opacity-70" aria-label="Home">
          <span class="text-base-subtle">~/</span>0xrifki
        </a>

        <!-- Desktop nav -->
        <ul class="hidden items-center gap-1 font-code text-sm text-base-subtle sm:flex">
          {NAV.map(({ href, label }) => (
            <li>
              <a href={href} class="rounded px-3 py-1.5 transition-colors hover:bg-base-overlay hover:text-base-text">
                {label}
              </a>
            </li>
          ))}
        </ul>

        <!-- Hamburger button (mobile only) -->
        <button
          id="menu-btn"
          class="flex sm:hidden flex-col justify-center items-center gap-1.5 p-2 text-base-subtle hover:text-base-text transition-colors"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span class="hamburger-bar block h-px w-5 bg-current transition-all duration-300"></span>
          <span class="hamburger-bar block h-px w-5 bg-current transition-all duration-300"></span>
          <span class="hamburger-bar block h-px w-5 bg-current transition-all duration-300"></span>
        </button>

      </nav>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="hidden border-t border-base-overlay bg-base-bg/95 backdrop-blur-md sm:hidden"
      >
        <ul class="mx-auto flex max-w-5xl flex-col px-6 py-4 font-code text-sm text-base-subtle">
          {NAV.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="flex items-center gap-2 py-3 transition-colors hover:text-base-text border-b border-base-overlay last:border-0"
              >
                <span class="text-base-muted">→</span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <!-- ── Main ────────────────────────────────────────────────────────────── -->
    <main class="mx-auto w-full max-w-5xl flex-1 px-6 py-16">
      <slot />
    </main>

    <!-- ── Footer ──────────────────────────────────────────────────────────── -->
    <footer class="border-t border-base-overlay bg-base-bg-alt">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
        <span class="font-code text-sm text-base-muted">
          &copy; {new Date().getFullYear()} 0xrifki
        </span>
        <div class="flex items-center gap-4">
          {SOCIAL.map(({ href, label, icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              class="text-base-muted transition-colors hover:text-base-teal"
            >
              <Fragment set:html={icon} />
            </a>
          ))}
        </div>
      </div>
    </footer>

  </body>
</html>

<script>
  const btn  = document.getElementById("menu-btn");
  const menu = document.getElementById("mobile-menu");
  const bars = btn.querySelectorAll(".hamburger-bar");

  btn.addEventListener("click", () => {
    const isOpen = menu.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));

    if (isOpen) {
      bars[0].classList.add("translate-y-[7px]", "rotate-45");
      bars[1].classList.add("opacity-0");
      bars[2].classList.add("-translate-y-[7px]", "-rotate-45");
    } else {
      bars[0].classList.remove("translate-y-[7px]", "rotate-45");
      bars[1].classList.remove("opacity-0");
      bars[2].classList.remove("-translate-y-[7px]", "-rotate-45");
    }
  });

  menu.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      btn.setAttribute("aria-expanded", "false");
      bars[0].classList.remove("translate-y-[7px]", "rotate-45");
      bars[1].classList.remove("opacity-0");
      bars[2].classList.remove("-translate-y-[7px]", "-rotate-45");
    });
  });

  document.addEventListener("DOMContentLoaded", () => {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.style.animationPlayState = "running";
          obs.unobserve(e.target);
        }
      }),
      { threshold: 0.05 }
    );
    document.querySelectorAll("[data-animate]").forEach((el) => {
      el.style.animationPlayState = "paused";
      obs.observe(el);
    });
  });
</script>