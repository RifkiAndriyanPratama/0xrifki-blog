---
// src/components/SidebarLeft.astro
// Kolom kiri: profil singkat, kategori, newsletter, currently reading.
import Avatar from "./Avatar.astro";
import { siteConfig } from "@/config/site";

interface Props {
  categories: { name: string; count: number }[];
  postCount: number;
  threadCount: number;
}

const { categories } = Astro.props;

const socialIcons: Record<string, string> = {
  GitHub:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.11-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.76.12 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>',
  Instagram:
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>',
  RSS: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>',
};

const newsletterRss = siteConfig.newsletter.rssHref;
---

<aside class="flex flex-col gap-8" aria-label="Profil dan navigasi">
  <!-- Profil -->
  <section class="flex items-start gap-4">
    <Avatar size="lg" letter={siteConfig.avatarLetter} />
    <div class="min-w-0">
      <h1 class="font-serif text-xl font-semibold leading-tight text-base-heading">{siteConfig.name}</h1>
      <p class="text-sm text-base-muted">{siteConfig.username}</p>
      <p id="typed-role" class="mt-1 min-h-4 text-sm leading-snug text-base-subtle">{siteConfig.typewriter[0]}</p>
    </div>
  </section>

  <div class="flex items-center gap-1">
    {siteConfig.socials.map((s) => s.label === "RSS" ? (
      <a href={s.href} aria-label={s.label} class="flex h-9 w-9 items-center justify-center rounded-full text-base-muted transition-colors hover:bg-base-bg-alt hover:text-base-heading" set:html={socialIcons[s.label]} />
    ) : (
      <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="flex h-9 w-9 items-center justify-center rounded-full text-base-muted transition-colors hover:bg-base-bg-alt hover:text-base-heading" set:html={socialIcons[s.label]} />
    ))}
  </div>

  <!-- Kategori -->
  <section>
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-base-subtle">Kategori</h2>
    <ul class="flex flex-col">
      {categories.map((cat, i) => (
        <li key={cat.name}>
          <a
            href={`/blog/category/${cat.name}`}
            class="group flex items-center justify-between py-1.5 text-sm text-base-subtle transition-colors hover:text-base-teal"
            style={`border-bottom: 1px solid ${i < categories.length - 1 ? "var(--color-overlay)" : "transparent"}`}
          >
            <span class="capitalize">{cat.name}</span>
            <span class="rounded-full bg-base-bg-alt px-2 py-0.5 text-xs text-base-muted transition-colors group-hover:bg-base-accent-light group-hover:text-base-teal">
              {cat.count}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Newsletter -->
  <section class="rounded-xl bg-base-bg-alt p-4">
    <h3 class="text-sm font-semibold text-base-heading">📬 Langganan</h3>
    <p class="mt-1 text-xs leading-relaxed text-base-subtle">Dapatkan tulisan terbaru via RSS.</p>
    <form id="newsletter-form" class="mt-3 flex flex-col gap-2">
      <input
        type="email"
        id="newsletter-email"
        required
        maxlength="254"
        placeholder="email@domain.com"
        class="h-10 w-full rounded-lg border border-base-overlay bg-base-surface px-3 text-sm text-base-text placeholder:text-base-muted focus:border-base-teal focus:outline-none"
      />
      <button
        type="submit"
        class="h-10 w-full rounded-lg bg-base-teal text-sm font-semibold text-white transition hover:bg-base-blue"
      >
        Subscribe
      </button>
    </form>
    <p id="newsletter-msg" class="mt-2 hidden text-xs text-base-subtle">
      Terima kasih! Situs ini berjalan tanpa backend — feed RSS-nya sudah terbuka untukmu.
    </p>
  </section>

  <!-- Currently reading -->
  <section class="accent-border space-y-1">
    <p class="text-xs font-semibold uppercase tracking-wider text-base-subtle">Currently Reading</p>
    <p class="text-sm font-semibold text-base-heading">{siteConfig.currentlyReading.book}</p>
    <p class="text-xs text-base-muted">oleh {siteConfig.currentlyReading.author}</p>
    <div class="mt-1 h-1 w-full overflow-hidden rounded-full bg-base-bg-alt">
      <div class="h-full rounded-full bg-base-teal" style={`width:${siteConfig.currentlyReading.progress}%`}></div>
    </div>
    <p class="text-xs text-base-muted">{siteConfig.currentlyReading.progress}% selesai</p>
  </section>

  <!-- Now playing -->
  {siteConfig.nowPlaying.enabled && (
    <section class="rounded-xl border border-base-overlay p-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-base-subtle">Now Playing</h2>
      <div class="mt-2 flex items-center gap-3">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-base-accent-light text-base-teal" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </div>
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-base-heading">{siteConfig.nowPlaying.title}</p>
          <p class="truncate text-xs text-base-muted">{siteConfig.nowPlaying.artist}</p>
          <p class="truncate font-code text-[10px] text-base-teal">{siteConfig.nowPlaying.note}</p>
        </div>
      </div>
    </section>
  )}

  <!-- GitHub stats -->
  {siteConfig.githubStats.enabled && (
    <section>
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-base-subtle">Kredit Coding</h2>
      <img
        src={`https://github-readme-stats.vercel.app/api/top-langs/?username=${siteConfig.githubStats.username}&layout=compact&hide_border=true&bg_color=00000000&title_color=b4533a&text_color=8a8076&icon_color=b4533a`}
        alt={`Bahasa yang paling sering dipakai ${siteConfig.githubStats.username}`}
        loading="lazy"
        width="260"
        height="120"
        class="w-full rounded-xl border border-base-overlay"
      />
    </section>
  )}
</aside>

<form id="newsletter-msg-form" class="hidden" aria-hidden="true"></form>

<script is:inline define:vars={{ phrases: siteConfig.typewriter, rssHref: newsletterRss }}>
  // Typing effect untuk tagline yang berputar.
  (() => {
    const el = document.getElementById("typed-role");
    if (!el) return;
    if (!phrases.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let i = 0, j = 0, deleting = false;
    const tick = () => {
      const word = phrases[i];
      if (!word) return;
      if (!deleting) {
        j++;
        el.textContent = word.slice(0, j);
        if (j === word.length) { deleting = true; setTimeout(tick, 2400); return; }
      } else {
        j--;
        el.textContent = word.slice(0, j);
        if (j === 0) { deleting = false; i = (i + 1) % phrases.length; }
      }
      setTimeout(tick, deleting ? 26 : 55);
    };
    tick();
  })();

  // Newsletter tanpa backend: tampilkan pesan konfirmasi + buka feed RSS.
  (() => {
    const form = document.getElementById("newsletter-form");
    const msg = document.getElementById("newsletter-msg");
    if (!form) return;
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      if (!form.checkValidity()) return;
      if (rssHref) window.open(rssHref, "_blank", "noopener");
      form.querySelector("button").disabled = true;
      form.querySelector("button").textContent = "✓ Terlanggan";
      msg.classList.remove("hidden");
    });
  })();
</script>