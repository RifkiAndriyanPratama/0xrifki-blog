---
// src/components/BottomNav.astro
// Navigasi bawah untuk mobile (di atas laman md:header). Ikon + label.
const path = Astro.url.pathname;
const items = [
  { label: "Home",       href: "/",          active: path === "/", icon: "M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10" },
  { label: "Blog",       href: "/blog",      active: path.startsWith("/blog"), icon: "M4 19.5A2.5 2.5 0 016.5 17H20V2H6.5A2.5 2.5 0 004 4.5v15zM4 19.5A2.5 2.5 0 006.5 22H20v-5" },
  { label: "Frames",     href: "/frames",    active: path.startsWith("/frames"),  icon: "M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4V4h8v2h4a2 2 0 012 2z" },
  { label: "Topic",      href: "/categories", active: path.startsWith("/categories"), icon: "M3 9l9-6 9 6v9a2 2 0 01-2 2H5a2 2 0 01-2-2z" },
  { label: "About",      href: "/about",     active: path.startsWith("/about"), icon: "M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z" },
];
---

<nav
  class="fixed inset-x-0 bottom-0 z-50 flex items-stretch border-t border-base-overlay bg-base-surface md:hidden"
  aria-label="Navigasi bawah"
>
  {items.map((item) => (
    <a
      href={item.href}
      aria-current={item.active ? "page" : undefined}
      class:list={[
        "flex flex-col items-center justify-center gap-0.5 flex-1 py-2 text-[10px] font-medium transition-colors",
        item.active ? "text-base-teal" : "text-base-muted hover:text-base-heading",
      ]}
      style="padding-bottom: max(0.5rem, env(safe-area-inset-bottom));"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d={item.icon} />
      </svg>
      {item.label}
    </a>
  ))}
</nav>