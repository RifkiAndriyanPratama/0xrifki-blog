---
// src/components/PostCover.astro
// Renders a post cover. Accepts either a processed Astro image asset
// (from content schema `image()`) or a plain path/URL string (e.g. /uploads/..).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  mode?: "featured" | "thumb" | "hero" | "wide";
  class?: string;
}

const { src, alt, mode = "thumb" } = Astro.props;
const cls: string = Astro.props.class ?? "";
const isAsset = typeof src !== "string";
---

{isAsset ? (
  mode === "hero" || mode === "wide" ? (
    <Image
      src={src}
      alt={alt}
      class={cls}
      widths={[400, 800, 1200]}
      sizes="(min-width: 1024px) 680px, 100vw"
      loading={mode === "hero" ? "eager" : "lazy"}
    />
  ) : mode === "featured" ? (
    <Image
      src={src}
      alt={alt}
      class={cls}
      widths={[400, 600]}
      sizes="(min-width: 640px) 280px, 100vw"
      loading="lazy"
    />
  ) : (
    <Image src={src} alt={alt} class={cls} width={80} height={80} loading="lazy" />
  )
) : (
  <img
    src={src}
    alt={alt}
    class={cls}
    loading={mode === "hero" ? "eager" : "lazy"}
    width={mode === "thumb" ? 80 : undefined}
    height={mode === "thumb" ? 80 : undefined}
  />
)}