---
// src/components/Header.astro
import { siteConfig } from "@/config/site";

const path = Astro.url.pathname;
const nav = [
  { label: "Home",     href: "/",          active: path === "/" },
  { label: "Blog",     href: "/blog",      active: path.startsWith("/blog") },
  { label: "Frames",   href: "/frames",    active: path.startsWith("/frames") },
  { label: "Kategori", href: "/categories", active: path.startsWith("/categories") },
  { label: "Tentang",  href: "/about",     active: path.startsWith("/about") },
];
---

<header id="site-header" class="sticky top-0 z-40 border-b border-base-overlay bg-base-bg/90 backdrop-blur">
  <div class="mx-auto flex h-14 w-full max-w-[1240px] items-center justify-between gap-3 px-4 sm:px-6 md:px-8">
    <a href="/" class="flex shrink-0 items-baseline gap-0.5 font-serif text-lg font-bold tracking-tight text-base-heading sm:text-xl" aria-label={siteConfig.name}>
      thestoriesrifki<span class="text-base-teal">.</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Navigasi utama">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class:list={[
              "text-sm font-medium transition-colors",
              item.active
                ? "text-base-heading"
                : "text-base-subtle hover:text-base-heading",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <button
        id="search-btn"
        aria-label="Cari artikel"
        title="Cari (Ctrl+K)"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-base-overlay text-base-subtle transition-colors hover:bg-base-bg-alt hover:text-base-heading"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      </button>

      <button
        id="theme-toggle"
        aria-label="Ganti tema"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-base-overlay text-base-subtle transition-colors hover:bg-base-bg-alt hover:text-base-heading"
      >
        <svg id="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        <svg id="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const KEY = "tsr-theme";
    const root = document.documentElement;
    const btn = document.getElementById("theme-toggle");
    const sun = document.getElementById("icon-sun");
    const moon = document.getElementById("icon-moon");

    function apply(theme) {
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
      if (btn) btn.setAttribute("aria-label", theme === "dark" ? "Mode terang" : "Mode gelap");
      sun?.classList.toggle("hidden", theme !== "dark");
      moon?.classList.toggle("hidden", theme !== "light");
    }
    btn?.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      try { localStorage.setItem(KEY, next); } catch {}
      apply(next);
    });
    document.addEventListener("astro:page-load", () => apply(root.dataset.theme || "light"));
  })();
</script>

<script is:inline>
  // Progressive header: menghilang saat scroll ke bawah, muncul lagi saat scroll ke atas.
  (() => {
    const header = document.getElementById("site-header");
    if (!header) return;
    let lastY = window.scrollY;

    const onScroll = () => {
      const y = window.scrollY;
      const delta = y - lastY;
      lastY = y;
      if (y < 64) { header.classList.remove("header-hide"); return; }
      if (delta > 8 && !header.classList.contains("header-hide")) {
        header.classList.add("header-hide");
      } else if (delta < -8 && header.classList.contains("header-hide")) {
        header.classList.remove("header-hide");
      }
    };

    window.removeEventListener("scroll", onScroll);
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>