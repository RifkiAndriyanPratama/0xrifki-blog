---
// src/components/SidebarRight.astro
// Kolom kanan: about, popular, tags, popular frames, moodboard.
// Pada tablet (md→lg) kolom ini jadi grid 2-kolom full-width; di lg+ jadi kolom kanan.
import PostCover from "./PostCover.astro";
import { siteConfig } from "@/config/site";
import { readingTime, isFoto } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  popularPosts: CollectionEntry<"posts">[];
  popularThreads: CollectionEntry<"posts">[];
  tags: { name: string; count: number }[];
}

const { popularPosts, popularThreads, tags } = Astro.props;
---

<aside class="grid gap-8 md:grid-cols-2 md:content-start min-w-0 lg:grid-cols-1" aria-label="Samping (about, populer)">
  <!-- About -->
  <section class="rounded-xl border border-base-overlay bg-base-surface p-5">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-base-subtle">Tentang</h2>
    <p class="mt-3 text-sm leading-relaxed text-base-subtle">{siteConfig.about.text}</p>
    <a href="/about" class="mt-3 inline-block text-sm font-medium text-base-teal transition-colors hover:underline">
      Selengkapnya →
    </a>
  </section>

  <!-- Popular posts -->
  <section>
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-base-subtle">🔥 Popular</h2>
    <div class="flex flex-col">
      {popularPosts.map((post, i) => (
        <a key={post.slug} href={`/blog/${post.slug}/`} class="group flex items-center gap-3 rounded-lg p-2 transition-colors hover:bg-base-bg-alt">
          <span class="w-5 shrink-0 font-code text-xs font-bold text-base-teal">{String(i + 1).padStart(2, "0")}</span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium leading-snug text-base-heading line-clamp-1 transition-colors group-hover:text-base-teal">
              {post.data.title}
            </p>
            <p class="text-xs text-base-muted">
              {post.data.readingTime ?? readingTime(post.body)} min{isFoto(post) ? " · frame" : ""}
            </p>
          </div>
          {!isFoto(post) && post.data.cover && (
            <PostCover
              src={post.data.cover}
              alt={post.data.coverAlt ?? post.data.title}
              mode="thumb"
              class="h-10 w-10 shrink-0 rounded-lg object-cover"
            />
          )}
        </a>
      ))}
    </div>
  </section>

  <!-- Tags -->
  <section>
    <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-base-subtle">🏷️ Tags</h2>
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <a
          key={tag.name}
          href={`/search?q=${encodeURIComponent(tag.name)}`}
          class="tag-chip text-xs"
          style="--tag-color:var(--color-teal)"
        >
          #{tag.name}
          <span class="ml-1 text-[10px] text-base-muted">{tag.count}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Popular frames -->
  {popularThreads.length > 0 && (
    <section>
      <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-base-subtle">Foto Terpopuler</h2>
      <div class="flex flex-col gap-3">
        {popularThreads.map((t) => {
          const photos = t.data.photos ?? [];
          const photo = photos[0];
          return (
            <a key={t.slug} href={`/blog/${t.slug}/`} class="group flex items-center gap-3">
              <div class="h-14 w-14 shrink-0 overflow-hidden rounded-xl bg-base-accent-light">
                {photo
                  ? <img src={photo} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                  : <div class="flex h-full w-full items-center justify-center text-base-teal"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></div>}
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium leading-snug text-base-heading line-clamp-2 transition-colors group-hover:text-base-teal">
                  {t.data.description || t.data.title}
                </p>
                <p class="mt-0.5 text-xs text-base-muted">{photos.length} foto</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Moodboard -->
  <section class="accent-border">
    <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-base-subtle">🌊 Moodboard</p>
    {siteConfig.moodboard.quotes.map((q, idx) => (
      <div class:list={["mood-quote", idx !== 0 && "hidden"]}>
        <blockquote class="font-serif text-sm italic leading-relaxed text-base-subtle">
          {q.quote}
        </blockquote>
        <cite class="mt-2 block font-code text-[11px] not-italic text-base-muted">— {q.source}</cite>
      </div>
    ))}
  </section>

  <!-- Random post -->
  <section>
    <button
      id="random-post-btn"
      class="flex w-full items-center justify-center gap-2 rounded-full border border-base-overlay bg-base-surface px-4 py-2.5 text-sm font-semibold text-base-subtle transition-colors hover:border-base-teal hover:text-base-heading"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M4 20L21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/></svg>
      Acak Tulisan
    </button>
  </section>
</aside>

<script is:inline>
  // Rotate satu kutipan moodboard secara acak per muat halaman.
  (() => {
    const quotes = document.querySelectorAll(".mood-quote");
    if (quotes.length > 1) {
      quotes.forEach((q, i) => q.classList.toggle("hidden", i !== Math.floor(Math.random() * quotes.length)));
    }
  })();

  // Acak tulisan: ambil dari index pencarian (ringan, sudah ada).
  (() => {
    const btn = document.getElementById("random-post-btn");
    if (!btn) return;
    btn.addEventListener("click", async () => {
      try {
        const res = await fetch("/search-index.json");
        const list = await res.json();
        if (!list.length) return;
        const pick = list[Math.floor(Math.random() * list.length)];
        window.location.href = `/blog/${encodeURIComponent(pick.slug)}/`;
      } catch {}
    });
  })();
</script>