---
// src/components/PostRow.astro
// Article list row: thumbnail left, category/title/description/meta right.
import PostCover from "./PostCover.astro";
import { formatDate, isoDate, readingTime } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const readTime = post.data.readingTime ?? readingTime(post.body);
---

<a
  href={`/blog/${post.slug}/`}
  class="group flex items-start gap-3 border-t border-base-overlay py-4 first:border-t-0 sm:gap-4"
>
  {post.data.cover && (
    <div class="hidden w-24 shrink-0 overflow-hidden rounded-xl sm:block">
      <PostCover
        src={post.data.cover}
        alt={post.data.coverAlt ?? post.data.title}
        mode="thumb"
        class="h-24 w-full object-cover transition-transform duration-300 group-hover:scale-105 sm:w-28"
      />
    </div>
  )}
  <div class="min-w-0 flex-1">
    <div class="mb-1 flex flex-wrap items-center gap-1.5 text-xs text-base-muted">
      <span class="rounded-full border border-base-overlay px-2 py-0.5 capitalize">{post.data.category}</span>
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readTime} min read</span>
    </div>
    <h3 class="text-base font-semibold leading-snug text-base-heading transition-colors group-hover:text-base-teal sm:text-lg">
      {post.data.title}
    </h3>
    <p class="mt-0.5 text-sm text-base-subtle line-clamp-2 leading-relaxed">{post.data.description}</p>
  </div>
</a>