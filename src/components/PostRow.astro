---
// src/components/PostRow.astro
// Kartu tulisan: thumbnail kiri, kategori/deskripsi/meta kanan (spesifikasi UI).
import PostCover from "./PostCover.astro";
import { formatDate, isoDate, readingTime, isFoto } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const readTime = post.data.readingTime ?? readingTime(post.body);
const foto = isFoto(post);
const firstPhoto = (post.data.photos ?? [])[0];
---

<article class="card-hover group flex items-start gap-4 rounded-xl border border-base-overlay bg-base-surface p-4 sm:gap-5 sm:p-5">
  <a
    href={`/blog/${post.slug}/`}
    class="h-20 w-20 shrink-0 overflow-hidden rounded-lg bg-base-accent-light sm:h-20 sm:w-20"
    tabindex="-1"
    aria-hidden="true"
  >
    {post.data.cover ? (
      <PostCover
        src={post.data.cover}
        alt={post.data.coverAlt ?? post.data.title}
        mode="thumb"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : foto && firstPhoto ? (
      <img src={firstPhoto} alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
    ) : (
      <span class="flex h-full w-full items-center justify-center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-base-teal/70"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg></span>
    )}
  </a>
  <a href={`/blog/${post.slug}/`} class="min-w-0 flex-1 space-y-1.5">
    <span class="inline-block text-xs font-medium uppercase tracking-wider text-base-teal">{post.data.category}</span>
    <h3 class="font-serif text-lg font-semibold leading-snug text-base-heading transition-colors group-hover:text-base-teal sm:text-lg">
      {post.data.title}
    </h3>
    <p class="text-sm leading-relaxed text-base-subtle line-clamp-2">{post.data.description}</p>
    <div class="flex items-center gap-2 text-xs text-base-muted">
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readTime} min read</span>
    </div>
  </a>
</article>