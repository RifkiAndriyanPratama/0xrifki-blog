---
// src/components/FrameCard.astro
// Kartu frame (Latest Frames): foto/placeholder di atas, judul + tanggal di bawah.
import { formatDate, isoDate } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  thread: CollectionEntry<"posts">;
}

const { thread } = Astro.props;
const photo = (thread.data.photos ?? [])[0];
---

<a
  href={`/blog/${thread.slug}/`}
  class="card-hover group block overflow-hidden rounded-xl border border-base-overlay bg-base-surface"
>
  <div class="h-32 overflow-hidden bg-gradient-to-br from-base-accent-light to-base-accent-light sm:h-36">
    {photo ? (
      <img
        src={photo}
        alt={thread.data.description || thread.data.title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <div class="flex h-full items-center justify-center">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-base-teal/60"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
      </div>
    )}
  </div>
  <div class="space-y-1 p-4">
    <p class="text-sm font-semibold leading-snug text-base-heading line-clamp-1 transition-colors group-hover:text-base-teal">
      {thread.data.title}
    </p>
    <p class="text-xs text-base-muted">
      <time datetime={isoDate(thread.data.date)}>{formatDate(thread.data.date)}</time>
    </p>
  </div>
</a>