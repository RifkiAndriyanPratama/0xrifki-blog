---
// src/components/PostCard.astro
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { readingTime } from "@/lib/utils";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { data, slug, body } = post;
const readTime = data.readingTime ?? readingTime(body);

const isoDate = data.date.toISOString().slice(0, 10);
const months = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agu", "Sep", "Okt", "Nov", "Des"];
const dateObj = new Date(data.date);
const displayDate = `${dateObj.getDate()} ${months[dateObj.getMonth()]} ${dateObj.getFullYear()}`;
---

<article class="group py-6">
  <a href={`/blog/${slug}/`} class="no-underline! flex flex-col gap-4">

    <!-- Meta: date + read time -->
    <div class="flex items-center gap-2 text-sm text-base-muted">
      <time datetime={isoDate}>{displayDate}</time>
      <span aria-hidden="true">·</span>
      <span>{readTime} min baca</span>
    </div>

    <!-- Title -->
    <h3 class="text-2xl font-bold leading-snug tracking-tight text-base-heading md:text-[1.65rem]">
      <span class="transition-colors group-hover:text-base-teal">{data.title}</span>
    </h3>

    <!-- Excerpt -->
    <p class="line-clamp-2 text-[15px] leading-relaxed text-base-subtle">
      {data.description}
    </p>

    <!-- Cover image -->
    {data.cover && (
      <div class="mt-1 overflow-hidden rounded-xl border border-base-overlay">
        <Image
          src={data.cover}
          alt={data.coverAlt ?? data.title}
          class="h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          widths={[400, 800]}
          sizes="(min-width: 768px) 720px, 100vw"
          loading="lazy"
        />
      </div>
    )}

  </a>
</article>
