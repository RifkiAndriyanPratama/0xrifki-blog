---
// src/components/PostCard.astro
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  variant?: "default" | "compact";
}

const { post, variant = "default" } = Astro.props;
const { data, slug } = post;
const isCompact = variant === "compact";
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-base-overlay bg-base-surface transition-all duration-200 hover:border-base-teal/40 hover:shadow-lg hover:shadow-base-teal/5">
  <a href={`/blog/${slug}/`} class="no-underline!">
    <!-- Cover thumbnail -->
    {data.cover && !isCompact && (
      <div class="aspect-video overflow-hidden bg-base-overlay">
        <Image
          src={data.cover}
          alt={data.title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          widths={[400, 800]}
          sizes="(min-width: 768px) 400px, 100vw"
          loading="lazy"
        />
      </div>
    )}

    <div class="flex flex-col gap-5 p-7">
      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-3 text-xs text-base-muted">
        <time datetime={data.date.toISOString()}>
          {new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" }).format(data.date)}
        </time>
        {data.updated && data.updated.getTime() !== data.date.getTime() && (
          <>
            <span class="text-base-muted">·</span>
            <span class="text-base-yellow">updated</span>
          </>
        )}
        {data.category && (
          <>
            <span class="text-base-muted">·</span>
            <span class="text-base-teal">{data.category}</span>
          </>
        )}
        {data.featured && (
          <>
            <span class="text-base-muted">·</span>
            <span class="text-base-orange">★ featured</span>
          </>
        )}
      </div>

      <!-- Title & description -->
      <h3 class={`font-semibold leading-snug text-base-text transition-colors group-hover:text-base-teal ${isCompact ? "text-base" : "text-xl"}`}>
        {data.title}
      </h3>

      {!isCompact && (
        <p class="text-[15px] leading-relaxed text-base-subtle line-clamp-3">
          {data.description}
        </p>
      )}

      <!-- Tags & reading time -->
      <div class="flex flex-wrap items-center gap-3">
        {data.tags?.slice(0, 3).map((tag) => (
          <span class="rounded bg-base-overlay px-2 py-0.5 text-xs text-base-muted">
            #{tag}
          </span>
        ))}
        <span class="text-xs text-base-muted">
          {data.readingTime} min read
        </span>
      </div>
    </div>
  </a>
</article>
