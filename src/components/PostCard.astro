---
// src/components/PostCard.astro
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  variant?: "default" | "compact";
}

const { post, variant = "default" } = Astro.props;
const { data, slug } = post;
const isCompact = variant === "compact";
---

<article class="group relative post-card card-hover">
  <a href={`/blog/${slug}/`} class="no-underline!">
    <div class="flex flex-col gap-3">

      <!-- Cover thumbnail -->
      {data.cover && !isCompact && (
        <div class="overflow-hidden rounded-xl border border-base-overlay">
          <img
            src={data.cover}
            alt={data.title}
            class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </div>
      )}

      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-2 font-code text-xs text-base-muted">
        <time datetime={data.date.toISOString()}>
          {new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" }).format(data.date)}
        </time>
        {data.updated && data.updated.getTime() !== data.date.getTime() && (
          <>
            <span class="text-base-muted">·</span>
            <span class="text-base-yellow">updated</span>
          </>
        )}
        {data.category && (
          <>
            <span class="text-base-muted">·</span>
            <span class="text-base-teal">{data.category}</span>
          </>
        )}
        {data.featured && (
          <>
            <span class="text-base-muted">·</span>
            <span class="text-base-orange">★ featured</span>
          </>
        )}
      </div>

      <!-- Title & description -->
      <h3 class={`font-semibold leading-snug text-base-text transition-colors group-hover:text-base-teal ${isCompact ? "text-base" : "text-lg"}`}>
        {data.title}
      </h3>

      {!isCompact && (
        <p class="text-sm leading-relaxed text-base-subtle line-clamp-2">
          {data.description}
        </p>
      )}

      <!-- Tags & reading time -->
      <div class="flex flex-wrap items-center gap-2">
        {data.tags?.slice(0, 3).map((tag) => (
          <span class="rounded bg-base-overlay px-2 py-0.5 font-code text-[11px] text-base-muted">
            #{tag}
          </span>
        ))}
        <span class="font-code text-[11px] text-base-muted">
          {data.readingTime} min read
        </span>
      </div>

    </div>
  </a>

  <!-- Hover gradient border (pseudo-element driven by CSS) -->
  <div class="gradient-border-hover pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-400 group-hover:opacity-100" aria-hidden="true"></div>
</article>
