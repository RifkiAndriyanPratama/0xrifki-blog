---
// src/components/PhotoCard.astro
// Threads-style feed card: caption on top, swipeable photo strip inline.
import PhotoCarousel from "./PhotoCarousel.astro";
import { formatDate, isoDate } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const photos = post.data.photos ?? [];
---

<div class="rounded-2xl border border-base-overlay p-4 transition-colors hover:border-base-teal sm:p-5">
  <div class="flex flex-wrap items-center gap-1.5 text-xs text-base-muted sm:gap-2 sm:text-sm">
    <span class="rounded-full border border-base-overlay px-2 py-0.5 capitalize sm:px-2.5">{post.data.category}</span>
    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
  </div>

  <a href={`/blog/${post.slug}/`} class="group mt-2 block">
    <h3 class="font-serif text-lg font-bold leading-snug tracking-tight text-base-heading transition-colors group-hover:text-base-teal sm:text-xl">
      {post.data.title}
    </h3>
  </a>

  {post.data.description && (
    <p class="mt-1 text-sm text-base-subtle leading-relaxed">{post.data.description}</p>
  )}

  <div class="mt-4">
    <PhotoCarousel photos={photos} alt={post.data.coverAlt ?? post.data.title} />
  </div>
</div>