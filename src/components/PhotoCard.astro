---
// src/components/PhotoCard.astro
// Threads-style feed card: caption on top, swipeable photo strip inline.
import PhotoCarousel from "./PhotoCarousel.astro";
import { formatDate, isoDate } from "@/lib/utils";
import { tintBg, isLightTint, type Tint } from "@/lib/tint";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
  tint?: Tint;
}

const { post } = Astro.props;
const photos = post.data.photos ?? [];
const tint = Astro.props.tint;
const tinted = tint !== undefined;
const light = tinted && isLightTint(tint!);
const metaText = tinted ? (light ? "text-black/70" : "text-white/75") : "text-base-muted";
const chipCls = tinted ? (light ? "border-black/25 text-black/80" : "border-white/40 text-white/90") : "border-base-overlay";
const titleCls = tinted
  ? (light ? "text-black group-hover:opacity-75" : "text-white group-hover:opacity-85")
  : "text-base-heading group-hover:text-base-teal";
const descCls = tinted ? (light ? "text-black/80" : "text-white/85") : "text-base-subtle";
---

<div
  class:list={[
    "rounded-2xl border p-4 transition-colors sm:p-5",
    tinted
      ? (light ? "border-transparent" : "border-white/15")
      : "border-base-overlay hover:border-base-teal",
  ]}
  style={tint ? { background: tintBg(tint) } : undefined}
>
  <div class:list={["flex flex-wrap items-center gap-1.5 text-xs sm:gap-2 sm:text-sm", metaText]}>
    <span class:list={["rounded-full border px-2 py-0.5 capitalize sm:px-2.5", chipCls]}>
      {post.data.category}
    </span>
    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
  </div>

  <a href={`/blog/${post.slug}/`} class="group mt-2 block">
    <h3
      class:list={[
        "font-serif text-lg font-bold leading-snug tracking-tight transition-colors sm:text-xl",
        titleCls,
      ]}
    >
      {post.data.title}
    </h3>
  </a>

  {post.data.description && (
    <p class:list={["mt-1 text-sm leading-relaxed", descCls]}>{post.data.description}</p>
  )}

  <div class="mt-4">
    <PhotoCarousel photos={photos} alt={post.data.coverAlt ?? post.data.title} />
  </div>
</div>