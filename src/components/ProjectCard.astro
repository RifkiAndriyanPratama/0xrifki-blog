---
// src/components/ProjectCard.astro
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { name, description, stack, github, url, cover, coverAlt, status } = project.data;

const STATUS_STYLES: Record<string, string> = {
  wip:      "text-base-yellow border-base-yellow/40",
  done:     "text-base-green  border-base-green/40",
  archived: "text-base-subtle border-base-subtle/40",
};
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-base-overlay bg-base-surface transition-all duration-200 hover:border-base-teal/40 hover:shadow-lg hover:shadow-base-teal/5">
  <a href={`/projects/${project.id}`} class="no-underline!">

    <!-- ── Cover image ────────────────────────────────────────────────────────── -->
    {cover ? (
      <div class="aspect-video overflow-hidden bg-base-overlay">
        <Image
          src={cover}
          alt={coverAlt ?? name}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          widths={[400, 800]}
          sizes="(min-width: 768px) 400px, 100vw"
          loading="lazy"
        />
      </div>
    ) : (
      <!-- Placeholder — initial letters + subtle pattern -->
      <div class="aspect-video overflow-hidden bg-base-overlay flex items-center justify-center card-grid-pattern">
        <span class="font-code text-3xl font-bold text-base-muted select-none">
          {name.slice(0, 2)}
        </span>
      </div>
    )}

    <!-- ── Card body ──────────────────────────────────────────────────────────── -->
    <div class="flex flex-1 flex-col gap-3 p-5">

      <!-- Name + status -->
      <div class="flex items-start justify-between gap-2">
        <h2 class="text-base font-semibold text-base-text group-hover:text-base-teal transition-colors">
          {name}
        </h2>
        <span class={`shrink-0 rounded border px-2 py-0.5 text-[10px] uppercase tracking-wider ${STATUS_STYLES[status]}`}>
          {status}
        </span>
      </div>

      <!-- Description -->
      <p class="flex-1 text-sm leading-relaxed text-base-subtle line-clamp-2">
        {description}
      </p>

      <!-- Stack badges -->
      {stack.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {stack.map((tech) => (
            <span class="rounded bg-base-overlay px-2 py-0.5 text-xs text-base-subtle">
              {tech}
            </span>
          ))}
        </div>
      )}

      <!-- Links -->
      <div class="flex flex-wrap items-center gap-3 pt-1">
        {url && (
          <span class="flex items-center gap-1 text-xs text-base-teal">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            live
          </span>
        )}
        {github && (
          <span class="flex items-center gap-1 text-xs text-base-muted">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            source
          </span>
        )}
      </div>
    </div>
  </a>
</article>
