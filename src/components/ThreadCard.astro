---
// src/components/ThreadCard.astro
// Kartu thread (post type "foto"): avatar + username, caption, carousel, aksi.
import PhotoCarousel from "./PhotoCarousel.astro";
import Avatar from "./Avatar.astro";
import { siteConfig } from "@/config/site";
import { formatDate, isoDate } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

interface Props {
  thread: CollectionEntry<"posts">;
  full?: boolean;
  body?: any;
}

const { thread, full = false } = Astro.props;
const Body = Astro.props.body;
const photos = thread.data.photos ?? [];
const caption = thread.data.description || thread.data.title;
---

<article
  class:list={[
    "flex flex-col rounded-2xl border border-base-overlay bg-base-surface p-4 sm:p-5",
    full ? "w-full" : "w-[85vw] max-w-[380px] shrink-0 snap-start sm:w-[360px]",
  ]}
>
  <div class="flex items-center gap-3">
    <Avatar size="sm" letter={siteConfig.avatarLetter} />
    <div class="min-w-0">
      <p class="truncate text-sm font-bold text-base-heading">{siteConfig.name}</p>
      <p class="text-xs text-base-muted">
        {siteConfig.username} · <time datetime={isoDate(thread.data.date)}>{formatDate(thread.data.date)}</time>
      </p>
    </div>
  </div>

  <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-base-text sm:text-[0.95rem]">{caption}</p>

  {Body && (
    <div class="mt-2 text-sm leading-relaxed text-base-subtle [&_p]:my-0">
      <Body />
    </div>
  )}

  {photos.length > 0 && (
    <div class="mt-3">
      <PhotoCarousel photos={photos} alt={thread.data.title} />
    </div>
  )}

  <div
    class:list={["mt-3 flex items-center gap-4 text-base-muted", full && "border-t border-base-overlay pt-3 gap-8"]}
    aria-hidden="true"
  >
    <button type="button" class="flex items-center gap-1.5 transition-colors hover:text-base-red" tabindex="-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <span class="text-xs">12</span>
    </button>
    <button type="button" class="flex items-center gap-1.5 transition-colors hover:text-base-teal" tabindex="-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      <span class="text-xs">8</span>
    </button>
    <button type="button" class="flex items-center gap-1.5 transition-colors hover:text-base-teal" tabindex="-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
      <span class="text-xs">5</span>
    </button>
    <button type="button" class="ml-auto transition-colors hover:text-base-heading" tabindex="-1">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><line x1="8.7" y1="10.8" x2="15.3" y2="7.2"/><line x1="8.7" y1="13.2" x2="15.3" y2="16.8"/></svg>
    </button>
  </div>
</article>